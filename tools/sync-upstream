#!/bin/bash

# Re-vendor the bar from an upstream checkout and re-apply the Literate Bar
# patches. Run this on the matching upstream-* branch after a new Omarchy
# release, then merge that branch into its main-* branch.
#
#   tools/sync-upstream /path/to/omarchy-checkout
#   tools/sync-upstream                # defaults to the installed Omarchy
#
# The vendored copy must match the Omarchy shell it runs against: Bar.qml
# imports Style, Color and BarModel from the host shell, so a bar vendored
# from a different release can break on API drift.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_ROOT="${1:-${OMARCHY_PATH:-/usr/share/omarchy}}"
BAR_DIR="$SOURCE_ROOT/shell/plugins/bar"

[[ -d $BAR_DIR ]] || {
  echo "sync-upstream: no bar plugin at $BAR_DIR" >&2
  exit 1
}

# Refuse to vendor the wrong flavour of bar onto a branch.
#
# SOURCE_ROOT defaults to the *installed* Omarchy, which on this machine is
# omarchy-mac. Run with that default while main-basecamp is checked out and it
# silently replaces the basecamp bar with the mac one -- 259 lines of Apple
# Silicon notch handling and API drift that basecamp's shell never asked for.
# That has already happened once, and it is invisible: the tree still validates
# and the bar still renders here, because here is a Mac.
#
# appleSiliconHost is the defining difference between the two bases, so it
# identifies the flavour without trusting a path or a branch name alone.
if grep -q appleSiliconHost "$BAR_DIR/Bar.qml" 2>/dev/null; then
  source_flavour=mac
else
  source_flavour=basecamp
fi

branch=$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
case "$branch" in
*basecamp*) want_flavour=basecamp ;;
*mac*) want_flavour=mac ;;
*) want_flavour="" ;;
esac

if [[ -n $want_flavour && $want_flavour != "$source_flavour" ]]; then
  echo "sync-upstream: refusing to vendor the $source_flavour bar onto '$branch'." >&2
  echo "  source: $BAR_DIR" >&2
  echo "  Pass a matching checkout instead, e.g." >&2
  echo "    tools/sync-upstream /path/to/$want_flavour-omarchy-checkout" >&2
  exit 1
fi

# Vendor everything upstream ships, but keep what this fork owns: our README,
# our tools, and git's own directory.
# Anything this fork owns must be listed here: --delete removes every file in
# the destination that upstream does not ship, so an unlisted fork-owned file
# is silently destroyed by the next sync.
rsync -a --delete \
  --exclude .git \
  --exclude .gitignore \
  --exclude README.md \
  --exclude CLAUDE.md \
  --exclude LICENSE \
  --exclude tools \
  --exclude Workspaces.qml \
  --exclude Overlay.qml \
  --exclude phosphor-codepoints.json \
  --exclude fonts \
  --exclude bin \
  --exclude fixtures \
  "$BAR_DIR/" "$REPO_ROOT/"

python3 "$REPO_ROOT/tools/apply-patches.py" "$REPO_ROOT"

echo "Vendored from $BAR_DIR"
git -C "$REPO_ROOT" status --short
