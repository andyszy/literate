# A window class that is reverse-DNS shaped but has no desktop entry to speak
# for it, and whose last segment prettifies to the wrong thing. These are the
# app-ids Omarchy invents for its terminal apps: "org.omarchy.claude" is a
# Claude Code session, not an app called "Claude".
REVERSE_DNS_NAMES = {
    "org.omarchy.claude": "Claude Code",
    "org.omarchy.terminal": "Terminal",
    "org.omarchy.bash": "Terminal",
    "org.omarchy.btop": "System Monitor",
    "org.omarchy.about": "About Omarchy",
    "org.omarchy.screensaver": "Screensaver",
    "org.omarchy.tui": "Terminal",
    "com.anthropic.claude": "Claude",
}

# Hosts whose last two labels are a public suffix, so the registrable name is
# the third label back. Not a full public-suffix list -- just enough that
# "bbc.co.uk" doesn't come out as "Co".
MULTI_LABEL_TLDS = {
    "co.uk", "org.uk", "ac.uk", "gov.uk", "co.jp", "co.kr", "co.nz", "co.za",
    "co.in", "com.au", "com.br", "com.mx", "com.cn", "com.tr", "net.au",
}

# "chrome-<host>__<path>-<Profile>" -- the class Chrome gives a site app.
RE_PWA_CLASS = re.compile(r"^chrome-(?P<host>[^_\s/]+?)__(?P<rest>.*)$", re.I)
# ...and the shape with no path at all, which some Chrome versions emit.
RE_PWA_CLASS_BARE = re.compile(r"^chrome-(?P<host>[^_\s/]+?)-(?:Default|Profile[ _]?\d+)$", re.I)
# The separators a GUI title uses between its parts, with surrounding space.
RE_TITLE_SEP = re.compile(r"\s+[-–—|·•:]\s+")
RE_EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
RE_CAMEL = re.compile(r"(?<=[a-z0-9])(?=[A-Z])")
# A trailing segment longer than this is prose, not a site's name for itself.
BRANDING_TAIL_MAX = 40


def registrable_label(host):
    """The one label of a host that names the organisation: "github" for
    support.github.com, "bbc" for www.bbc.co.uk."""
    labels = [l for l in (host or "").split(".") if l]
    if len(labels) >= 3 and ".".join(labels[-2:]) in MULTI_LABEL_TLDS:
        return labels[-3]
    if len(labels) >= 2:
        return labels[-2]
    return labels[0] if labels else ""


def prettify_token(token):
    """A machine token -> words. Separators become spaces and camelCase is
    broken apart, then title_case_name() capitalises what is safe to touch
    (it leaves acronyms and internal caps alone, so "macOS" survives)."""
    spaced = RE_CAMEL.sub(" ", re.sub(r"[-_.]+", " ", token or ""))
    return title_case_name(" ".join(spaced.split()))


def site_name(host):
    """The human name for a web host. Exact host, then the same host without
    "www.", then each parent domain -- so docs.github.com reaches GitHub
    without an entry of its own. Anything unknown falls back to the
    registrable label, title-cased: never the bare hostname."""
    host = (host or "").strip().lower().rstrip(".")
    if not host:
        return ""
    if host in KNOWN_HOSTS:
        return KNOWN_HOSTS[host]
    if host.startswith("www."):
        host = host[4:]
        if host in KNOWN_HOSTS:
            return KNOWN_HOSTS[host]
    labels = host.split(".")
    for i in range(1, len(labels) - 1):
        parent = ".".join(labels[i:])
        if parent in KNOWN_HOSTS:
            return KNOWN_HOSTS[parent]
    return prettify_token(registrable_label(host))


def pwa_host(cls):
    """The host inside a Chrome site-app class, or "". A class with no dot in
    the host part isn't one of these, whatever else it may be."""
    cls = (cls or "").strip()
    for pattern in (RE_PWA_CLASS, RE_PWA_CLASS_BARE):
        m = pattern.match(cls)
        if m:
            host = m.group("host")
            if "." in host:
                return host.lower()
    return ""


def reverse_dns_name(cls):
    """Layer 4, the one that must always answer. A reverse-DNS app-id gives up
    its last segment; anything else is prettified whole. The result is never
    the raw class -- an unnamed window says "Foo Bar", not "org.foo.fooBar"."""
    cls = (cls or "").strip()
    if not cls:
        return ""
    known = REVERSE_DNS_NAMES.get(cls.lower())
    if known:
        return known
    segments = [s for s in cls.split(".") if s]
    token = segments[-1] if len(segments) >= 3 else cls
    return prettify_token(token) or prettify_token(cls)


def title_segments(title):
    """(segments, offsets) for a title split on its separators. offsets[i] is
    where the separator *after* segment i starts, so a caller that drops
    trailing segments can slice the original string and keep every inner
    separator exactly as the app wrote it."""
    segments, offsets, last = [], [], 0
    for m in RE_TITLE_SEP.finditer(title or ""):
        segments.append((title[last:m.start()]))
        offsets.append(m.start())
        last = m.end()
    segments.append((title or "")[last:])
    return segments, offsets


def _same_name(a, b):
    """Loose equality for names: case and punctuation don't count."""
    norm = lambda s: re.sub(r"[^a-z0-9]+", "", (s or "").lower())
    a, b = norm(a), norm(b)
    return bool(a) and a == b


def _redundant_tail(segment, app, host):
    """Is this trailing title segment saying something the app column already
    says? Conservative on purpose: only the app's own name, the host, or an
    account address. Anything else is subject matter and stays."""
    segment = (segment or "").strip()
    if not segment:
        return True
    if RE_EMAIL.match(segment):
        return True
    if _same_name(segment, app):
        return True
    if host and (_same_name(segment, host) or _same_name(segment, site_name(host))
                 or _same_name(segment, registrable_label(host))):
        return True
    return False


def branding_tail(title):
    """The site's own name for itself, which browsers leave at the end of a
    page title ("... #4731655 - GitHub Support"). Only a short trailing
    segment counts; a long one is the sentence continuing."""
    segments, _ = title_segments(title or "")
    if len(segments) < 2:
        return ""
    tail = segments[-1].strip()
    if not tail or len(tail) > BRANDING_TAIL_MAX or RE_EMAIL.match(tail):
        return ""
    if not any(c.isalpha() for c in tail):
        return ""
    return tail


def split_title(title, app="", host=""):
    """One run-on title -> (subject, context). The subject is what the window
    is actually about; the context is the account or site that the title
    repeated after it. Never strips everything: a title that is nothing but
    its app name keeps that as its subject rather than going blank."""
    title = strip_status_glyphs((title or "").strip()).strip()
    segments, offsets = title_segments(title)
    keep = len(segments)
    dropped = []
    while keep > 1 and _redundant_tail(segments[keep - 1], app, host):
        dropped.insert(0, segments[keep - 1].strip())
        keep -= 1
    subject = (title[:offsets[keep - 1]] if keep < len(segments) else title).strip()
    useful = [d for d in dropped if d and not _same_name(d, app)]
    context = " · ".join(useful) or (host or "")
    return subject, context


def window_identity(cls, title, chrome_window=None, expose_host=True, desktop=None):
    """The whole chain, for one window: which app this is, what the window is
    about, and the account or site behind it. chrome_window is this window's
    entry from chrome-tabs.json when the two could be matched (see
    match_chrome_windows) -- the only way to learn a bare browser window's
    site, since Chrome never puts the URL in the OS window title."""
    desktop = DESKTOP_INDEX if desktop is None else desktop
    cls = (cls or "").strip()
    title = strip_status_glyphs((title or "").strip()).strip()
    host = ""
    icon = ""

    if isinstance(chrome_window, dict):
        tabs = chrome_window.get("tabs")
        tabs = [t for t in tabs if isinstance(t, dict)] if isinstance(tabs, list) else []
        active = next((t for t in tabs if t.get("active")), None)
        if active is None:
            active = next((t for t in tabs if t.get("title") == title), None)
        if active is not None:
            host = registrable_domain(active.get("url") or "").lower()

    if cls.lower() in CHROME_CLASSES:
        # Layer 3. The tab's own branding beats anything derived from the
        # host, because it is what the site calls itself today; the host is
        # the answer for a page whose title carries no branding at all.
        app, source = branding_tail(title), "tab-title"
        if not app:
            app, source = site_name(host), "tab-host"
        if not app:
            entry = desktop.lookup(cls)
            if entry:
                app, icon, source = entry["name"], entry["icon"], "desktop"
            else:
                app, source = reverse_dns_name(cls), "class"
    else:
        entry = desktop.lookup(cls)  # layer 1
        if entry:
            app, icon, source = entry["name"], entry["icon"], "desktop"
        else:
            site = pwa_host(cls)  # layer 2
            if site:
                host = host or site
                app, source = site_name(site), "pwa"
            else:
                app, source = reverse_dns_name(cls), "class"  # layer 4

    subject, context = split_title(title, app, host if expose_host else "")
    return {
        "app": app,
        "subject": subject,
        "context": context,
        "host": host if expose_host else "",
        "appIcon": icon,
        "appSource": source,
    }


# --------------------------------------------------------------- omnibox index
#
# Pure, model-free, and read-only against two on-disk sources: past Claude
# Code transcripts (~/.claude/projects/) and Chrome's History sqlite database.
# Kept as module-level functions, not Namer methods, so `--index-omnibox` and
# the unit tests can call them without spinning up hyprctl/cache/state.

def decode_project_slug(slug):
    """Best-effort reverse of the directory name Claude Code stores a
    project's transcripts under, e.g. "-home-andy" for "/home/andy".

    The forward direction is simple (every "/" in the real path becomes
    "-"), but it is lossy to invert in general: a path segment that already
    contains a "-" -- a scratchpad directory embeds a session id, which
    does, e.g. "-tmp-claude-1001--home-andy-<uuid>-scratchpad" for
    "/tmp/claude-1001/-home-andy/<uuid>/scratchpad" -- looks identical to a
    slash once encoded. Rather than guess at a split that merely looks
    plausible, only trust a decode that resolves to a directory that
    actually exists; anything else falls back to $HOME.
    """
    home_slug = str(HOME).replace("/", "-")
    if slug == home_slug:
        return str(HOME)
    if slug.startswith(home_slug + "-"):
        candidate = HOME / slug[len(home_slug) + 1:].replace("-", "/")
        if candidate.is_dir():
            return str(candidate)
    candidate = Path(slug.replace("-", "/"))
    if candidate.is_dir():
        return str(candidate)
    return str(HOME)  # unresolvable (commonly a scratchpad slug) -- fall back


def _iter_transcripts():
    """(project, path) for every *.jsonl transcript under every project
    directory. A project directory can also hold a per-session subdirectory
    (Claude Code's own scratchpad workdir) alongside the transcript of the
    same name -- glob("*.jsonl") already excludes those, nothing to skip."""
    if not CLAUDE_PROJECTS_DIR.is_dir():
        return
    for proj_dir in CLAUDE_PROJECTS_DIR.iterdir():
        if not proj_dir.is_dir():
            continue
        project = decode_project_slug(proj_dir.name)
        yield from ((project, path) for path in proj_dir.glob("*.jsonl"))


def scan_transcript(path):
    """(title, line_count) for one transcript, or (None, line_count) if it
    carries no {"type":"ai-title",...} record.

    Transcripts can run to several MB, and the title record is not
    necessarily near the top (it can be re-emitted partway through a
    session), so this reads every line once but only ever calls json.loads
    on the rare line that contains the literal substring "ai-title" --
    everything else is a plain bytes membership test. line_count is a cheap
    stand-in for message count (used only for ranking, so exactness doesn't
    matter) and falls out of the same pass for free. A retitle mid-session
    means more than one ai-title record can appear; keep the last one."""
    title, count = None, 0
    try:
        with path.open("rb") as f:
            for raw_line in f:
                count += 1
                if b'"type":"ai-title"' not in raw_line:
                    continue
                try:
                    rec = json.loads(raw_line)
                except (ValueError, UnicodeDecodeError):
                    continue  # truncated/malformed line -- keep scanning
                candidate = rec.get("aiTitle") if isinstance(rec, dict) else None
                if isinstance(candidate, str) and candidate.strip():
                    title = candidate.strip()
    except OSError as e:
        log("omnibox: cannot read transcript", path, e)
    return title, count


def build_conversations(limit=OMNIBOX_CONV_LIMIT):
    """Every titled transcript, newest first, capped at `limit` so the JSON
    stays small. A transcript with no ai-title is skipped outright rather
    than inventing a name for it."""
    entries = []
    for project, path in _iter_transcripts():
        title, count = scan_transcript(path)
        if not title:
            continue
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue  # gone since the glob -- skip rather than crash the pass
        entries.append({
            "id": path.stem,  # the transcript is named <sessionId>.jsonl
            "title": title,
            "project": project,
            "mtime": int(mtime),
            "messages": count,
        })
    entries.sort(key=lambda e: e["mtime"], reverse=True)
    return entries[:limit]


def webkit_to_unix(webkit_time):
    """Chrome stores visit times as microseconds since 1601-01-01, not the
    unix epoch -- convert, or every timestamp in the index is off by 369
    years."""
    return int(webkit_time / 1_000_000 - WEBKIT_EPOCH_DELTA)


def build_history(limit=OMNIBOX_HISTORY_LIMIT):
    """Chrome's History database, ranked by a blend of recency and visit
    count and capped at `limit`. Missing/unreadable DB (Chrome not
    installed, profile not named Default, ...) -- or any other failure --
    yields [] rather than raising; the omnibox is still useful with half its
    data missing, so a caller must never crash over this."""
    if not CHROME_HISTORY_PATH.exists():
        return []
    try:
        import sqlite3
        # "immutable=1" tells sqlite the file will not change underneath it
        # and to skip its normal locking -- verified to open in a few ms with
        # no lock contention even while Chrome is running. Read-only by
        # construction: there is no ATTACH, no journal, nothing that could
        # write back to Chrome's live database.
        con = sqlite3.connect(f"file:{CHROME_HISTORY_PATH}?immutable=1", uri=True)
        try:
            rows = con.execute(
                "SELECT url, title, visit_count, last_visit_time FROM urls "
                "WHERE hidden = 0 AND title != '' "
                "AND (url LIKE 'http://%' OR url LIKE 'https://%') "
                "ORDER BY last_visit_time DESC LIMIT ?",
                (limit * 4,),  # oversample before the recency/visits blend re-ranks
            ).fetchall()
        finally:
            con.close()
    except Exception as e:
        log("omnibox: chrome history unavailable:", e)
        return []

    now = time.time()
    entries = []
    for url, title, visits, last_visit in rows:
        domain = registrable_domain(url)
        if not domain:
            continue
        entries.append({
            "title": title,
            "url": url,
            "domain": domain,
            # The same site_name()/KNOWN_HOSTS pair an open window goes
            # through, so a Gmail window and a Gmail history row are labelled
            # "Gmail" by one code path and cannot drift apart.
            "app": site_name(domain),
            "visits": visits or 0,
            "lastVisit": webkit_to_unix(last_visit) if last_visit else 0,
        })

    def score(e):
        age_days = (now - e["lastVisit"]) / 86400 if e["lastVisit"] else 3650
        return e["visits"] / (1 + max(0.0, age_days))

    entries.sort(key=score, reverse=True)
    return entries[:limit]


def build_omnibox_index():
    return {
        "updatedAt": int(time.time()),
        "conversations": build_conversations(),
        "history": build_history(),
    }


class Namer:
    def __init__(self):
        self.cfg = {**DEFAULTS, **load_json(CONFIG_PATH, {})}
        self.icons = load_json(PLUGIN_DIR / "phosphor-codepoints.json", {})
        if not self.icons:
            log("WARN: no phosphor-codepoints.json; icons will not be validated")
        self.cache = load_json(CACHE_PATH, {})
        self.state = load_json(STATE_PATH, {})
        self.pinned = load_json(PINNED_PATH, {})
        # {address: epoch seconds} of the last time each window took focus.
        # Read here so a short-lived CLI run (--triage, --suggest) can report
        # what the daemon has recorded; only the daemon ever writes it.
        self.focus = {str(k): int(v) for k, v in (load_json(FOCUS_PATH, {}) or {}).items()
                      if isinstance(v, (int, float)) and not isinstance(v, bool)}
        self.focus_lock = threading.Lock()
        self.focus_timer = None
        self.focus_dirty = False
        self.live_addresses = set()
        self.lock = threading.Lock()
        self.pass_lock = threading.Lock()
        # Triage precompute runs outside pass_lock (naming must never wait on
        # it), so it needs its own non-blocking guard against overlapping.
        self.triage_lock = threading.Lock()
        self.triage_sig = None
        self.triage_at = float("-inf")
        self.triage_retry = None
        self.timer = None
        self.first_event = None
        self.last_sigs = {}
        # monotonic time of the last fast-clear per workspace, so a slow
        # in-flight pass that started before the clear can tell its answer
        # is stale and drop it instead of resurrecting the workspace.
        self.cleared_at = {}
        # Same shape as the triage_* fields above: a non-blocking guard plus
        # a monotonic timestamp, so the omnibox rebuild can piggyback on the
        # daemon's own settled-pass timing without a poll loop.
        self.omnibox_lock = threading.Lock()
        self.omnibox_at = float("-inf")
        self.omnibox_history_mtime = None

    # ---------------------------------------------------------------- snapshot

    def _filtered_clients(self):
        """Yield (ws, class, title, address, identity) for every window hyprctl
        reports, after the filtering every caller needs: special/scratchpad
        workspaces (negative ids) skipped, ignore_classes honoured, titles
        cleaned and clamped. snapshot() and --suggest both build on this so the
        rules can't drift apart between them.

        `identity` is window_identity()'s app/subject/context/host split, and
        it is worked out *before* the Chrome URL suffix is folded in below --
        the suffix exists for the model's benefit and would otherwise show up
        inside the subject a person reads.

        Chrome windows also get a URL suffix folded into their title here
        (see chrome_url_suffix()), so every caller and the cache signature
        see it identically -- there's nowhere else this can live without
        the two drifting apart."""
        ignore = {c.lower() for c in self.cfg["ignore_classes"]}
        raw = []
        live = set()
        for c in hyprctl("clients"):
            live.add(normalize_address(c.get("address")))
            ws = (c.get("workspace") or {}).get("id")
            if not isinstance(ws, int) or ws < 1:
                continue  # special/scratchpad workspaces have negative ids
            cls = (c.get("initialClass") or c.get("class") or "").strip()
            if cls.lower() in ignore:
                continue
            title = clean_title((c.get("title") or "").strip())[: self.cfg["max_title_chars"]]
            raw.append([ws, cls, title, c.get("address", "")])
        # Every address Hyprland knows about, unfiltered -- prune_focus() needs
        # the full set or it would forget a scratchpad window every pass.
        self.live_addresses = live - {""}

        matches = self._chrome_matches(raw)
        mode = self.cfg.get("chrome_urls", "domain")
        identities = [window_identity(entry[1], entry[2], matches.get(i),
                                      expose_host=mode != "off")
                      for i, entry in enumerate(raw)]
        self._enrich_chrome_titles(raw, matches)

        for entry, identity in zip(raw, identities):
            yield (*entry, identity)

    @staticmethod
    def _chrome_matches(raw):
        """{index in raw: chrome-tabs.json window} for the browser windows the
        extension's last report can be lined up with unambiguously. Split out
        of _enrich_chrome_titles() because the app-name resolution needs the
        same pairing even when chrome_urls is "off" and no title is enriched:
        a bare browser window has no identity without its active tab."""
        chrome_windows = load_chrome_tabs()
        if not chrome_windows:
            return {}
        hypr_titles = [(i, entry[2]) for i, entry in enumerate(raw)
                       if entry[1].lower() in CHROME_CLASSES]
        if not hypr_titles:
            return {}
        return match_chrome_windows(hypr_titles, chrome_windows)

    def _enrich_chrome_titles(self, raw, matches):
        """Mutate raw (list of [ws, cls, title, address]) in place, appending
        URL info to any Chrome window title that matches one reported by the
        literate-tabs extension. No-op if chrome_urls is "off" or no fresh
        report exists -- an unmatched or unreported window is left exactly
        as it was, today's behaviour."""
        mode = self.cfg.get("chrome_urls", "domain")
        if mode not in ("domain", "full"):
            return
        for i, window in matches.items():
            suffix = chrome_url_suffix(raw[i][2], window, mode, self.cfg["max_title_chars"])
            if suffix:
                raw[i][2] = raw[i][2] + suffix

    @staticmethod
    def group_by_workspace(clients):
        """workspace id -> list of (class, title), for real workspaces only."""
        by_ws = {}
        for ws, cls, title, _addr, _identity in clients:
            by_ws.setdefault(str(ws), []).append((cls, title))
        for wins in by_ws.values():
            wins.sort()
        return by_ws

    @staticmethod
    def triage_windows(clients, focus=None):
        """The flat, indexed window list --triage groups and the triage cache
        stores. Split out from triage() so a pass can build it from the client
        list it already has, without a second hyprctl call.

        `lastFocus` is deliberately absent from triage_signature(): focusing a
        window is not a change to the window *set*, and hashing it in would
        throw away the precomputed grouping on every alt-tab."""
        return [{"index": i, "address": addr, "class": cls, "title": title,
                 "workspace": str(ws), **identity,
                 "lastFocus": focus.get(normalize_address(addr)) if focus else None}
                for i, (ws, cls, title, addr, identity) in enumerate(clients)]

    def snapshot(self):
        return self.group_by_workspace(self._filtered_clients())

    def workspace_windows(self, ws_id):
        """Every (filtered) window on one workspace, in hyprctl's own order,
        keeping the address -- snapshot() throws that away since naming only
        needs class+title, but --suggest hands addresses back to the caller."""
        return [{"address": addr, "class": cls, "title": title, **identity,
                 "lastFocus": self.last_focus(addr)}
                for ws, cls, title, addr, identity in self._filtered_clients() if ws == ws_id]

    @staticmethod
    def signature(windows):
        return json.dumps(windows, sort_keys=True)

    @staticmethod
    def triage_signature(windows):
        """A hash of the whole window set: every window's address, class,
        title and workspace. Sorted first, so merely reordering hyprctl's
        reply -- which happens on focus changes -- is not a change. This is
        the key the precomputed triage cache is stored and matched under."""
        key = sorted([w["address"], w["class"], w["title"], w["workspace"]] for w in windows)
        return hashlib.sha1(json.dumps(key).encode()).hexdigest()

    # ------------------------------------------------------------------- focus

    def last_focus(self, address):
        """Epoch seconds, or None for a window this daemon has never watched
        take focus. None is the honest answer and the UI has to render it as
        such -- inventing "now", or the window's age, would put a confident
        wrong number in the one column that exists to be trusted."""
        return self.focus.get(normalize_address(address))

    def note_focus(self, address, when=None):
        """activewindowv2 fired. No hyprctl, no model, no disk: a dict write
        and, at most once every FOCUS_FLUSH_INTERVAL, a timer. This runs on
        every alt-tab, so it has to cost nothing."""
        address = normalize_address(address)
        if not address:
            return  # activewindowv2 with an empty payload = focus left everything
        with self.focus_lock:
            self.focus[address] = int(time.time() if when is None else when)
            self.focus_dirty = True
            if self.focus_timer is None:
                self.focus_timer = threading.Timer(FOCUS_FLUSH_INTERVAL, self.flush_focus)
                self.focus_timer.daemon = True
                self.focus_timer.start()

    def flush_focus(self):
        """Write the coalesced batch. Atomic like every other state file, so a
        UI watching it never parses half a write."""
        with self.focus_lock:
            self.focus_timer = None
            if not self.focus_dirty:
                return
            payload = dict(self.focus)
            self.focus_dirty = False
        try:
            write_atomic(FOCUS_PATH, payload)
        except OSError as e:
            log("focus: write failed:", e)

    def forget_focus(self, address):
        """closewindow carries the address, so the cheapest possible prune is
        right here: the window is gone, its timestamp is meaningless."""
        address = normalize_address(address)
        if not address:
            return
        with self.focus_lock:
            gone = self.focus.pop(address, None) is not None
            if gone:
                self.focus_dirty = True
        if gone:
            self.flush_focus()

    def prune_focus(self, live):
        """The backstop for what forget_focus() missed -- windows that closed
        while the daemon was down, mostly. `live` is every address Hyprland
        reports, unfiltered, so ignore_classes and the scratchpad keep theirs.
        Without this the file grows for the life of the machine."""
        if not live:
            return
        with self.focus_lock:
            gone = [a for a in self.focus if a not in live]
            for a in gone:
                del self.focus[a]
            if gone:
                self.focus_dirty = True
        if gone:
            self.flush_focus()

    def seed_focus(self):
        """Hyprland sends no activewindowv2 to a socket that has just
        connected, so the window focused when the daemon starts would read as
        never-focused until someone touched something else. Stamping it is an
        observation, not a guess -- it *is* focused at this instant -- and it
        only ever applies to an address we have no record of, so a restart can
        never overwrite a real earlier timestamp with "now"."""
        try:
            address = normalize_address((hyprctl("activewindow") or {}).get("address"))
        except Exception as e:
            log("focus: seed skipped:", e)
            return
        if not address:
            return
        with self.focus_lock:
            if address in self.focus:
                return
        self.note_focus(address)

    # ------------------------------------------------------------------- model

    def read_key_file(self):
        try:
            return Path(self.cfg["api_key_file"]).expanduser().read_text().strip()
        except OSError:
            return ""

    def api_available(self):
        try:
            import anthropic  # noqa: F401
        except ImportError:
            return False
        return bool(self.read_key_file()
                    or os.environ.get("ANTHROPIC_API_KEY")
                    or os.environ.get("ANTHROPIC_AUTH_TOKEN")
                    or (HOME / ".config/anthropic").exists())  # `ant auth login` profile

    def backend(self):
        chosen = self.cfg["backend"]
        if chosen == "auto":
            chosen = "api" if self.api_available() else "claude-cli"
        if chosen != getattr(self, "_announced_backend", None):
            self._announced_backend = chosen
            log(f"backend: {chosen} ({self.cfg['model'] if chosen != 'local' else self.cfg['local_model']})")
        return chosen

    def ask(self, system, user):
        backend = self.backend()
        if backend == "claude-cli":
            return self._ask_claude_cli(system, user)
        if backend == "api":
            return self._ask_api(system, user)
        if backend == "local":
            return self._ask_local(system, user)
        raise RuntimeError(f"unknown backend: {backend}")

    def _ask_claude_cli(self, system, user):
        # Strip the coding-agent harness: no tools, no MCP servers, and not
        # Claude Code's own system prompt (which pulls every answer towards
        # "coding"). Extended thinking is on by default in the CLI and turns a
        # 4-second answer into a 90-second one -- off. (--bare would be nice
        # too, but it skips the keychain read that holds the login.)
        r = subprocess.run(
            ["claude", "-p", user, "--model", self.cfg["model"],
             "--tools", "", "--no-session-persistence",
             "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
             "--system-prompt", system,
             "--output-format", "json"],
            env={**os.environ, "MAX_THINKING_TOKENS": "0"},
            capture_output=True, text=True, timeout=self.cfg["request_timeout"],
        )
        if r.returncode != 0:
            raise RuntimeError(f"claude cli: {r.stderr.strip()[:300]}")
        try:
            envelope = json.loads(r.stdout)
        except ValueError:
            return r.stdout
        if isinstance(envelope, dict):
            if envelope.get("is_error"):  # the CLI still exits 0 on these
                raise RuntimeError(f"claude cli: {envelope.get('result', '')!s:.300}")
            if isinstance(envelope.get("structured_output"), dict):
                return json.dumps(envelope["structured_output"])
            if "result" in envelope:
                return str(envelope["result"])
        return r.stdout

    def _ask_api(self, system, user):
        import anthropic
        if not hasattr(self, "_client"):
            key = self.read_key_file()
            # No key file: the SDK resolves ANTHROPIC_API_KEY / an `ant auth
            # login` profile on its own.
            self._client = anthropic.Anthropic(api_key=key) if key else anthropic.Anthropic()
        try:
            response = self._client.with_options(timeout=self.cfg["request_timeout"]).messages.create(
                model=self.cfg["model"],
                max_tokens=1024,
                system=system,
                messages=[{"role": "user", "content": user}],
            )
        except anthropic.AuthenticationError as e:
            raise RuntimeError(
                f"API auth failed ({e.message}); put a key in {self.cfg['api_key_file']} "
                f"or export ANTHROPIC_API_KEY") from e
        except anthropic.APIStatusError as e:
            raise RuntimeError(f"API error {e.status_code}: {e.message}") from e
        except anthropic.APIConnectionError as e:
            raise RuntimeError(f"API unreachable: {e}") from e
        if response.stop_reason == "max_tokens":
            log("WARN: reply hit max_tokens; names may be missing")
        return "".join(block.text for block in response.content if block.type == "text")

    def _ask_local(self, system, user):
        import urllib.request
        body = json.dumps({
            "model": self.cfg["local_model"],
            "max_tokens": 512,
            "temperature": 0.2,
            "messages": [{"role": "system", "content": system},
                         {"role": "user", "content": user}],
        }).encode()
        req = urllib.request.Request(
            self.cfg["local_url"], data=body,
            headers={"content-type": "application/json"})
        with urllib.request.urlopen(req, timeout=self.cfg["request_timeout"]) as f:
            return json.load(f)["choices"][0]["message"]["content"]

    def parse(self, raw):
        data = extract_json(raw)
        if isinstance(data.get("workspaces"), list):
            return {str(e.get("id")): e for e in data["workspaces"] if isinstance(e, dict)}
        return {str(k): v for k, v in data.items()}  # tolerate the keyed shape too

    def clean(self, entry):
        """Trust nothing the model said; clamp the name, validate the icon."""
        name = str(entry.get("name", "")).strip().strip(".\"'")
        name = re.sub(r"\s+", " ", name)[: self.cfg["max_name_chars"]].strip()
        name = title_case_name(name)
        icon = str(entry.get("icon", "")).strip().lower().replace("_", "-")
        icon = re.sub(r"^ph[-.]", "", icon)
        icon = re.sub(r"-(fill|bold|light|thin|duotone|regular)$", "", icon)
        if self.icons and icon not in self.icons:
            icon = "app-window" if "app-window" in self.icons else ""
        return {"name": name, "icon": icon} if name else None

    def name_workspaces(self, pending, previous):
        answer = self.parse(self.ask(system_prompt(self.cfg["max_name_chars"]),
                                     user_prompt(pending, previous)))
        return {ws: self.clean(answer.get(ws) or {}) for ws in pending}

    # -------------------------------------------------------------------- pass

    def run_pass(self, precompute=False):
        started = time.monotonic()  # see the cleared_at check in apply()
        with self.pass_lock:
            try:
                clients = list(self._filtered_clients())
            except Exception as e:
                log("snapshot failed:", e)
                return
            # Cheap, and lets `--pin`/`--unpin` from another process take
            # effect without restarting the daemon.
            self.pinned = load_json(PINNED_PATH, {})
            # _filtered_clients() has just seen every address Hyprland knows
            # about, so the prune costs nothing extra here.
            self.prune_focus(self.live_addresses)
            self.apply(self.group_by_workspace(clients), started)
        # Deliberately outside pass_lock: naming is the job, triage is
        # opportunistic, and a slow model call here must not hold up the next
        # naming pass. Only the daemon's own debounced fire() asks for it --
        # `--once` stays a single-call operation.
        if precompute:
            self.maybe_precompute_triage(self.triage_windows(clients, self.focus))
            self.maybe_refresh_omnibox_index()

    def apply(self, current, started):
        pending, resolved, sigs = {}, {}, {}
        for ws, windows in current.items():
            sig = self.signature(windows)
            sigs[ws] = sig
            if ws in self.pinned:
                resolved[ws] = self.pinned[ws]  # pinned: never asked, never cached
            elif sig in self.cache:
                resolved[ws] = self.cache[sig]
            elif self.last_sigs.get(ws) == sig and ws in self.state:
                resolved[ws] = self.state[ws]  # asked already and it failed; keep
            else:
                pending[ws] = windows

        if pending:
            previous = {ws: self.state[ws]["name"] for ws in pending if ws in self.state}
            log(f"asking {self.cfg['backend']} about workspace(s) {','.join(sorted(pending, key=int))}")
            try:
                for ws, entry in self.name_workspaces(pending, previous).items():
                    if entry:
                        resolved[ws] = entry
                        self.cache[sigs[ws]] = entry
                write_atomic(CACHE_PATH, self.cache)
            except Exception as e:
                log("naming failed:", e)
                for ws in pending:
                    if ws in self.state:
                        resolved[ws] = self.state[ws]

        # fast_clear_empty_workspaces() can land while name_workspaces() above
        # was waiting on the model. If a workspace this pass started with went
        # empty since, its answer here is stale -- drop it rather than
        # resurrecting a workspace that has already been correctly cleared.
        for ws in list(resolved):
            if self.cleared_at.get(ws, 0) > started:
                del resolved[ws]

        self.last_sigs = sigs
        if resolved != self.state:
            self.state = resolved
            write_atomic(STATE_PATH, resolved)
            log("wrote", ", ".join(f"{k}={v['name']}/{v['icon']}"
                                   for k, v in sorted(resolved.items(), key=lambda kv: int(kv[0])))
                or "(empty)")

    # ------------------------------------------------------------------- test

    def test(self, fixture_path):
        fixture = load_json(fixture_path, None)
        if not isinstance(fixture, dict):
            sys.exit(f"cannot read fixture {fixture_path}")
        pending = {}
        for ws, windows in fixture.items():
            if not ws.isdigit():
                continue
            pending[ws] = sorted((cls, clean_title(title)[: self.cfg["max_title_chars"]])
                                 for cls, title in windows)
        t0 = time.time()
        try:
            result = self.name_workspaces(pending, {})
        except RuntimeError as e:  # a config/auth problem, not a bug: no traceback
            sys.exit(f"naming failed: {e}")
        print(f"backend={self.backend()} model={self.cfg['model']} "
              f"{len(pending)} workspaces in {time.time() - t0:.1f}s\n")
        for ws in sorted(pending, key=int):
            entry = result.get(ws) or {"name": "??", "icon": "??"}
            print(f"{ws:>2}  {entry['name']:<18} {entry['icon']:<18}  "
                  + " | ".join(f"[{c}] {t}" for c, t in pending[ws]))

    # ---------------------------------------------------------------- suggest

    def suggest(self, ws_arg):
        """One workspace, one model call: a fresh name plus any "spin out"
        groupings worth splitting onto their own workspace. Pure read path --
        no cache, no state file, no daemon loop. Returns (payload, exit_code)
        rather than printing/exiting itself, so tests can call it directly."""
        try:
            ws_id = int(ws_arg)
        except ValueError:
            return {"workspace": ws_arg, "error": "workspace id must be an integer"}, 1
        try:
            windows = self.workspace_windows(ws_id)
        except Exception as e:
            return {"workspace": ws_arg, "error": f"hyprctl failed: {e}"[:200]}, 1
        if not windows:
            return {"workspace": ws_arg, "error": "workspace has no windows"}, 1

        # Groups only make sense once there's something left to leave behind
        # after spinning windows out; below that, skip asking for them at all.
        want_groups = len(windows) > 2
        try:
            raw = self.ask(suggest_system_prompt(self.cfg["max_name_chars"], want_groups),
                            suggest_user_prompt(ws_arg, windows))
            data = extract_json(raw)
            if not isinstance(data, dict):
                raise ValueError("model reply was not a JSON object")
        except Exception as e:
            return {"workspace": ws_arg, "error": str(e)[:200]}, 1

        cleaned = self.clean(data)
        if not cleaned:
            return {"workspace": ws_arg, "error": "model did not return a usable name"}, 1

        groups = []
        if want_groups:
            for g in data.get("groups") or []:
                if not isinstance(g, dict):
                    continue
                try:
                    indices = sorted({int(i) for i in g.get("indices") or []})
                except (TypeError, ValueError):
                    continue  # trust nothing the model said
                if not indices or any(i < 0 or i >= len(windows) for i in indices):
                    continue  # references a window that doesn't exist
                if len(indices) >= len(windows):
                    continue  # not a strict subset -- must leave something behind
                cg = self.clean(g)
                if cg:
                    groups.append({"name": cg["name"], "icon": cg["icon"], "indices": indices})

        return {
            "workspace": ws_arg,
            "name": cleaned["name"],
            "icon": cleaned["icon"],
            "windows": [{"index": i, **w} for i, w in enumerate(windows)],
            "groups": groups,
        }, 0

    # ---------------------------------------------------------------- triage

    def triage(self, use_cache=True):
        """Every window on every real workspace, grouped by what the person is
        doing rather than which app is open. Returns (payload, exit_code).

        The daemon precomputes this after every settled naming pass, so the
        common case is a file read and no model call at all. A miss -- no
        cache, a window set that has moved on, or precompute switched off --
        falls back to asking the model live, exactly as this always did.
        `cached` in the payload says which happened."""
        try:
            windows = self.triage_windows(list(self._filtered_clients()), self.focus)
        except Exception as e:
            return {"error": f"hyprctl failed: {e}"[:200]}, 1
        if not windows:
            return {"categories": [], "windows": [], "cached": False}, 0

        signature = self.triage_signature(windows)
        if use_cache:
            hit = self.read_triage_cache(signature)
            if hit is not None:
                # The signature covers address/class/title/workspace, so a hit
                # says the window *set* is unchanged -- it says nothing about
                # focus, which has very likely moved since. Re-stamp from the
                # live map rather than serve a timestamp from whenever the
                # daemon happened to precompute.
                return {**hit, "windows": self.restamp_focus(hit.get("windows") or []),
                        "cached": True}, 0

        payload, code = self.compute_triage(windows)
        if code == 0 and use_cache:
            # A live miss still warms the cache: the next press is instant
            # even if the daemon is not running at all.
            self.write_triage_cache(signature, payload)
        payload["cached"] = False
        return payload, code

    def compute_triage(self, windows):
        """The model call and all the validation behind it. Shared verbatim by
        --triage's live path and the daemon's precompute, so the two can't
        drift into disagreeing about the shape of the answer."""
        try:
            raw = self.ask(triage_system_prompt(), triage_user_prompt(windows))
            data = extract_json(raw)
            if not isinstance(data, dict):
                raise ValueError("model reply was not a JSON object")
        except Exception as e:
            return {"error": str(e)[:200]}, 1

        # Trust nothing the model said: every index must name a real window,
        # and once an index has landed in one category it cannot land in
        # another -- a window must never appear twice.
        valid_indices = set(range(len(windows)))
        seen = set()
        categories = []
        for cat in data.get("categories") or []:
            if not isinstance(cat, dict):
                continue
            cleaned = self.clean(cat)
            if not cleaned:
                continue
            try:
                indices = sorted({int(i) for i in cat.get("indices") or []})
            except (TypeError, ValueError):
                continue
            indices = [i for i in indices if i in valid_indices and i not in seen]
            if not indices:
                continue
            seen.update(indices)
            categories.append({"name": cleaned["name"], "icon": cleaned["icon"], "indices": indices})

        # Anything the model missed, mis-indexed, or that came back malformed
        # must still show up somewhere rather than silently vanish.
        leftover = sorted(valid_indices - seen)
        if leftover:
            categories.append({
                "name": "Uncategorised",
                "icon": "app-window" if (not self.icons or "app-window" in self.icons) else "",
                "indices": leftover,
            })

        return {"categories": categories, "windows": windows}, 0

    # -------------------------------------------------------- triage cache

    @staticmethod
    def read_triage_cache(signature):
        """The cached grouping if it was computed for exactly this window set,
        else None. A missing, truncated or hand-mangled file is a miss, never
        an error -- the caller just asks the model instead."""
        data = load_json(TRIAGE_PATH, None)
        if not isinstance(data, dict) or data.get("signature") != signature:
            return None
        categories, windows = data.get("categories"), data.get("windows")
        if not isinstance(categories, list) or not isinstance(windows, list):
            return None
        return {"categories": categories, "windows": windows,
                "updatedAt": data.get("updatedAt")}

    def restamp_focus(self, windows):
        """Refresh lastFocus on a cached window list. Cheap dict lookups; the
        rest of each record is exactly what was cached."""
        return [{**w, "lastFocus": self.last_focus(w.get("address"))}
                if isinstance(w, dict) else w for w in windows]

    @staticmethod
    def write_triage_cache(signature, payload):
        write_atomic(TRIAGE_PATH, {
            "signature": signature,
            "categories": payload.get("categories") or [],
            "windows": payload.get("windows") or [],
            "updatedAt": int(time.time()),
        })

    def maybe_precompute_triage(self, windows):
        """Work out the triage grouping for the window set a settled pass just
        saw, so the triage key is a file read rather than a model call.

        Everything here is a reason not to ask:
          - switched off, or nothing is open;
          - this exact window set is already grouped (in memory, or on disk
            from another process's live --triage), so never twice for one
            signature;
          - the last precompute was too recent -- the naming cache is per
            workspace, but this signature is global, so one chatty title would
            otherwise re-ask about the whole desktop every debounce window;
          - one is already in flight.
        A failure is logged and dropped: the signature is not recorded, so the
        next settled pass retries, and --triage meanwhile just asks live."""
        if not self.cfg.get("triage_precompute", True) or not windows:
            return
        signature = self.triage_signature(windows)
        if signature == self.triage_sig:
            return
        if self.read_triage_cache(signature) is not None:
            self.triage_sig = signature
            return
        now = time.monotonic()
        wait = self.cfg["triage_min_interval"] - (now - self.triage_at)
        if wait > 0:
            # Not a poll: this re-runs the pass for a change that has already
            # happened, once, after the floor expires. Without it a burst of
            # changes followed by quiet would leave the cache stale until the
            # next Hyprland event -- which on an idle desktop is never, and
            # the next triage key would pay the full round-trip.
            log(f"triage precompute deferred {wait:.0f}s (under the "
                f"{self.cfg['triage_min_interval']:.0f}s floor)")
            with self.lock:
                if self.triage_retry:
                    self.triage_retry.cancel()
                self.triage_retry = threading.Timer(wait + 0.5, self.fire)
                self.triage_retry.daemon = True
                self.triage_retry.start()
            return
        if not self.triage_lock.acquire(blocking=False):
            return
        try:
            self.triage_at = now
            t0 = time.time()
            payload, code = self.compute_triage(windows)
            if code != 0:
                log("triage precompute failed:", payload.get("error"))
                return
            self.write_triage_cache(signature, payload)
            self.triage_sig = signature
            log(f"triage precomputed: {len(windows)} windows -> "
                f"{len(payload['categories'])} categories in {time.time() - t0:.1f}s")
        except Exception as e:  # opportunistic: never let this wedge the daemon
            log("triage precompute failed:", e)
        finally:
            self.triage_lock.release()

    # --------------------------------------------------------------- omnibox

    def _omnibox_changed(self):
        """Stat-only check (no file content read) for whether a rebuild is
        worth its cost: Chrome's History file moved since the last build, or
        some transcript is newer than the index we last wrote. Runs every
        settled pass once the min-interval floor clears, so it has to stay
        cheap even though the rebuild it's guarding is not."""
        try:
            history_mtime = CHROME_HISTORY_PATH.stat().st_mtime
        except OSError:
            history_mtime = None
        moved = history_mtime != self.omnibox_history_mtime
        self.omnibox_history_mtime = history_mtime
        if moved:
            return True
        try:
            index_mtime = OMNIBOX_INDEX_PATH.stat().st_mtime
        except OSError:
            return True  # never built yet
        try:
            return any(path.stat().st_mtime > index_mtime for _, path in _iter_transcripts())
        except OSError:
            return True

    def maybe_refresh_omnibox_index(self):
        """Rebuild the omnibox index opportunistically after a settled pass
        -- same shape as maybe_precompute_triage() above, deliberately: a
        non-blocking guard against overlapping rebuilds, a monotonic floor
        so one settled pass can't trigger a rebuild every debounce window,
        and a change check first so a quiet desktop with an unchanged
        History file and no new transcripts costs a handful of stat() calls,
        not a full rescan. No model call is involved, but scanning every
        transcript and querying Chrome's History file is still real I/O,
        so this stays capped and opportunistic exactly like triage is."""
        if not self.cfg.get("omnibox_index", True):
            return
        now = time.monotonic()
        if now - self.omnibox_at < OMNIBOX_MIN_INTERVAL:
            return
        if not self._omnibox_changed():
            return
        if not self.omnibox_lock.acquire(blocking=False):
            return
        try:
            self.omnibox_at = now
            t0 = time.time()
            payload = build_omnibox_index()
            write_atomic(OMNIBOX_INDEX_PATH, payload)
            log(f"omnibox index rebuilt: {len(payload['conversations'])} conversations, "
                f"{len(payload['history'])} history rows in {time.time() - t0:.2f}s")
        except Exception as e:  # opportunistic: never let this wedge the daemon
            log("omnibox index failed:", e)
        finally:
            self.omnibox_lock.release()

    # --------------------------------------------------------------------- pin

    def pin(self, ws_arg, name, icon=None):
        """One-shot, no daemon loop: fix a workspace's name/icon so apply()
        skips the model for it. Not tied to hyprctl at all -- a pin can be
        set for a workspace that has no windows (or doesn't exist) yet, so
        the menu can pin a spot ahead of opening anything in it."""
        ws = str(ws_arg)
        if icon is None:
            # No icon given: keep the one the workspace (or an existing pin
            # on it) already has, same as clean() falling back on its own.
            icon = (self.state.get(ws) or self.pinned.get(ws) or {}).get("icon", "")
        cleaned = self.clean({"name": name, "icon": icon})
        if not cleaned:
            return {"error": "name is empty after cleaning"}, 1
        self.pinned[ws] = cleaned
        write_atomic(PINNED_PATH, self.pinned)
        self.show_pin_now(ws, cleaned)
        return cleaned, 0

    def unpin(self, ws_arg):
        ws = str(ws_arg)
        if ws not in self.pinned:
            return {"error": f"workspace {ws} is not pinned"}, 1
        del self.pinned[ws]
        write_atomic(PINNED_PATH, self.pinned)
        self.show_pin_now(ws, None)
        return {}, 0

    @staticmethod
    def show_pin_now(ws, entry):
        """Push a pin straight onto the bar instead of waiting for a pass.

        pinned.json is what apply() consults, but workspaces.json is what the
        widget renders, and a pass only runs on a Hyprland event plus the
        debounce. Writing only the pin means a rename from the menu appears to
        do nothing on a quiet desktop -- the name is correct on disk and
        invisible for minutes. Write both.

        This races the daemon, which owns workspaces.json, but only benignly:
        a pass already in flight re-reads pinned.json before it decides, so
        the worst case is one stale render that the next pass corrects.
        """
        state = load_json(STATE_PATH, {})
        if entry is None:
            # Drop the old pinned label rather than leave it showing; the next
            # pass names the workspace again if it still has windows.
            if state.pop(ws, None) is None:
                return
        else:
            if state.get(ws) == entry:
                return
            state[ws] = entry
        write_atomic(STATE_PATH, state)

    # ------------------------------------------------------------------ events

    def fast_clear_empty_workspaces(self):
        """closewindow carries only the window's address, not its workspace,
        so there is no way to know which workspace to check without asking
        Hyprland -- but that ask needs no model call, just a diff against
        what we last knew had windows, so there is nothing to gain from
        waiting on the debounce for it. Wiping a workspace's entry the
        instant it goes to zero windows is what makes the bar clear
        immediately instead of lagging by a whole debounce window."""
        try:
            current = self.snapshot()
        except Exception as e:
            log("fast-clear snapshot failed:", e)
            return
        emptied = [ws for ws in self.state if ws not in current]
        if not emptied:
            return
        now = time.monotonic()
        for ws in emptied:
            self.cleared_at[ws] = now  # lets apply() reject a late, stale answer
        self.state = {ws: v for ws, v in self.state.items() if ws not in emptied}
        self.last_sigs = {ws: v for ws, v in self.last_sigs.items() if ws not in emptied}
        write_atomic(STATE_PATH, self.state)
        log("cleared", ",".join(sorted(emptied, key=int)), "(emptied)")

    def schedule(self):
        """Debounce, with a ceiling: a stream of events still yields a pass
        within max_wait of the first one."""
        now = time.monotonic()
        with self.lock:
            if self.timer:
                self.timer.cancel()
            if self.first_event is None:
                self.first_event = now
            delay = min(self.cfg["debounce"], max(0.0, self.first_event + self.cfg["max_wait"] - now))
            self.timer = threading.Timer(delay, self.fire)
            self.timer.daemon = True
            self.timer.start()

    def fire(self):
        with self.lock:
            self.first_event = None
        self.run_pass(precompute=True)

    def listen_forever(self):
        """Reconnect rather than die: the socket goes away on Hyprland reload."""
        while True:
            try:
                self.listen()
            except Exception as e:
                log("listener stopped:", e)
            time.sleep(2)

    def listen(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        if not sig:
            raise RuntimeError("HYPRLAND_INSTANCE_SIGNATURE unset -- is Hyprland running?")
        path = f"{runtime}/hypr/{sig}/.socket2.sock"

        watched = ("openwindow", "closewindow", "movewindowv2",
                   "windowtitlev2", "workspacev2", "createworkspacev2",
                   "destroyworkspacev2")
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(path)
        log("listening on", path)
        self.seed_focus()  # nothing replays the focus we missed before now
        self.schedule()  # name what's already open

        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                raise RuntimeError("hyprland socket closed")
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                event, _, payload = line.decode("utf-8", "replace").partition(">>")
                # Deliberately not in `watched`: which window has focus is not
                # a change to the window *set*, so it must never cost a naming
                # pass or a model call. Record it and move on.
                if event == "activewindowv2":
                    self.note_focus(payload)
                    continue
                if event == "closewindow":
                    self.forget_focus(payload)
                    self.fast_clear_empty_workspaces()
                if event in watched:
                    self.schedule()


if __name__ == "__main__":
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    namer = Namer()
    if "--test" in sys.argv:
        namer.test(sys.argv[sys.argv.index("--test") + 1])
    elif "--once" in sys.argv:
        namer.run_pass()
    elif "--suggest" in sys.argv:
        i = sys.argv.index("--suggest")
        if i + 1 >= len(sys.argv):
            sys.exit("--suggest requires a workspace id")
        try:
            payload, code = namer.suggest(sys.argv[i + 1])
        except Exception as e:  # a bug here must still exit clean, never a traceback
            payload, code = {"workspace": sys.argv[i + 1], "error": str(e)[:200]}, 1
        print(json.dumps(payload, separators=(",", ":")))
        sys.exit(code)
    elif "--triage" in sys.argv:
        try:
            payload, code = namer.triage(use_cache="--no-cache" not in sys.argv)
        except Exception as e:  # a bug here must still exit clean, never a traceback
            payload, code = {"error": str(e)[:200]}, 1
        print(json.dumps(payload, separators=(",", ":")))
        sys.exit(code)
    elif "--pin" in sys.argv:
        i = sys.argv.index("--pin")
        rest = sys.argv[i + 1:]
        if len(rest) < 2:
            print(json.dumps({"error": "--pin requires a workspace id and a name"}))
            sys.exit(1)
        ws_arg, name = rest[0], rest[1]
        icon = rest[2] if len(rest) > 2 else None
        result, code = namer.pin(ws_arg, name, icon)
        if code == 0:
            print(f'pinned workspace {ws_arg} as "{result["name"]}" ({result["icon"]})')
        else:
            print(json.dumps(result))
        sys.exit(code)
    elif "--unpin" in sys.argv:
        i = sys.argv.index("--unpin")
        if i + 1 >= len(sys.argv):
            print(json.dumps({"error": "--unpin requires a workspace id"}))
            sys.exit(1)
        ws_arg = sys.argv[i + 1]
        result, code = namer.unpin(ws_arg)
        if code == 0:
            print(f"unpinned workspace {ws_arg}")
        else:
            print(json.dumps(result))
        sys.exit(code)
    elif "--index-omnibox" in sys.argv:
        # One-shot, no daemon: pure local indexing, no model call, so this
        # is meant to be cheap enough to run from a shortcut or a timer, not
        # just from the daemon's own opportunistic refresh.
        t0 = time.time()
        try:
            payload = build_omnibox_index()
            write_atomic(OMNIBOX_INDEX_PATH, payload)
        except Exception as e:  # a bug here must still exit clean, never a traceback
            log("--index-omnibox failed:", e)
            sys.exit(1)
        log(f"omnibox index: {len(payload['conversations'])} conversations, "
            f"{len(payload['history'])} history rows in {time.time() - t0:.2f}s")
        sys.exit(0)
    else:
        namer.listen_forever()
