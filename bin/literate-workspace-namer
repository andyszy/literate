#!/usr/bin/env python3
"""Name Hyprland workspaces with an LLM, and pick a Phosphor icon for each.

Listens on Hyprland's socket2, debounces the churn, and whenever the set of
windows on a workspace actually changes it asks a model for a short name and
an icon. Results land in a JSON file the bar widget watches.

  state:  ~/.local/state/literate/workspaces.json
  pinned: ~/.local/state/literate/pinned.json
  cache:  ~/.local/state/literate/cache.json
  triage: ~/.local/state/literate/triage.json
  config: ~/.config/literate/config.json

  literate-workspace-namer                 run as a daemon
  literate-workspace-namer --once          one pass over the live desktop
  literate-workspace-namer --test FIXTURE  name a fixture; print, write nothing
  literate-workspace-namer --suggest ID    one workspace, one model call; print JSON, write nothing
  literate-workspace-namer --triage        every window, every workspace, grouped by activity (cached by the daemon)
  literate-workspace-namer --triage --no-cache   ...ignoring the daemon's cache; always ask the model
  literate-workspace-namer --pin ID NAME [ICON]  fix a workspace's name; the model skips it
  literate-workspace-namer --unpin ID            drop a pin; back to model-named
"""

import hashlib
import json
import os
import re
import unicodedata
import socket
import subprocess
import sys
import threading
import time
from collections import Counter
from pathlib import Path

HOME = Path.home()
STATE_DIR = HOME / ".local/state/literate"
VENV_DIR = HOME / ".local/share/literate/venv"

# The Anthropic SDK lives in a private venv (Arch ships no python-anthropic and
# no system pip). Put it on the path rather than pointing the shebang at the
# venv, so the daemon still starts -- on the CLI backend -- when the venv is
# missing.
for _site in VENV_DIR.glob("lib/python3*/site-packages"):
    sys.path.insert(0, str(_site))
CONFIG_PATH = HOME / ".config/literate/config.json"
# This script lives in <plugin>/bin/, possibly via a symlink from ~/.local/bin.
PLUGIN_DIR = Path(__file__).resolve().parent.parent
STATE_PATH = STATE_DIR / "workspaces.json"
CACHE_PATH = STATE_DIR / "cache.json"
# The daemon's precomputed --triage answer, so pressing the triage key costs a
# file read instead of a model round-trip. Keyed on a hash of the whole window
# set; a miss just falls back to asking live.
TRIAGE_PATH = STATE_DIR / "triage.json"
# Kept apart from STATE_PATH because that file is rewritten wholesale every
# pass -- a pin stored inside it would be gone the next time the model runs.
PINNED_PATH = STATE_DIR / "pinned.json"
# Written by the literate-tabs Chrome extension's native-messaging host
# (~/.config/omarchy/chrome-extensions/literate-tabs-host), not by this
# daemon -- read-only from here.
CHROME_TABS_PATH = STATE_DIR / "chrome-tabs.json"
# The extension only pushes on tab/window events, so a killed or disabled
# extension leaves a file that otherwise looks fine forever. Time it out
# ourselves rather than trust it indefinitely.
CHROME_TABS_MAX_AGE = 300
CHROME_CLASSES = {"google-chrome", "google-chrome-beta", "google-chrome-unstable",
                   "chromium", "chromium-browser"}

DEFAULTS = {
    # auto | api | claude-cli | local. auto = the API whenever a credential
    # can be found, else the Claude Code CLI (slower, but rides its login).
    "backend": "auto",
    "model": "claude-haiku-4-5",
    # A key here (mode 600) is scoped to this daemon; ANTHROPIC_API_KEY in the
    # session environment works too but is visible to every app.
    "api_key_file": str(HOME / ".config/literate/api-key"),
    # seconds of quiet before we ask; window titles churn a lot while you type
    "debounce": 3.0,
    # ...but never wait longer than this: a terminal whose title carries a
    # spinner (Claude Code's does) emits a title event every second forever.
    "max_wait": 10.0,
    "max_title_chars": 120,
    "max_name_chars": 18,
    # window classes left out of what the model sees
    "ignore_classes": [],
    # how much of a matched Chrome window's URL the model gets to see:
    # "domain" (host only, e.g. "mail.google.com"), "full" (the whole URL),
    # or "off" (none). Privacy-sensitive -- default stays the narrow one.
    "chrome_urls": "domain",
    # backend=local: any OpenAI-compatible /v1/chat/completions endpoint
    "local_url": "http://127.0.0.1:8080/v1/chat/completions",
    "local_model": "local",
    "request_timeout": 120,
    # After a settled naming pass, also work out the --triage grouping for the
    # current window set and cache it, so the triage view opens instantly
    # instead of waiting on a model call. Costs one extra call per settled
    # change to the *global* window set. False = exactly the old behaviour.
    "triage_precompute": True,
    # ...but never more often than this. The naming cache is per workspace, so
    # one noisy title only re-asks about one workspace; the triage signature is
    # global, so the same noise would re-ask about everything. This is the floor
    # that keeps that from turning into a call every debounce window.
    "triage_min_interval": 30.0,
}

# Almost every GUI app appends its own name to the title. Left in, the model
# sees the tool three times (class, suffix, and often the page chrome) and one
# quiet mention of what you're actually looking at -- so it names the tool.
RE_APP_SUFFIX = re.compile(
    r"\s*[-–—|·]\s*"
    r"(google chrome|chromium|mozilla firefox|firefox|brave|microsoft edge|safari"
    r"|visual studio code|vscodium|code ?- ?oss|neovim|nvim|vim|emacs"
    r"|slack|discord|telegram|signal|thunderbird|obsidian|zed|sublime text"
    r"|libreoffice (writer|calc|impress)|gimp|inkscape|blender|spotify|vlc|mpv)"
    r"\s*$", re.I)

RE_JSON = re.compile(r"\{.*\}", re.S)


def extract_json(raw):
    """Pull the one JSON object out of a model reply. Shared by the bulk
    parse() below and --suggest, which wants a differently-shaped object."""
    m = RE_JSON.search(raw or "")
    if not m:
        raise ValueError(f"no JSON in model reply: {(raw or '')[:200]!r}")
    return json.loads(m.group(0))

# A vocabulary hint, not a whitelist: any of the 1530 Phosphor names validates.
ICON_HINTS = """envelope chat-circle chats-circle phone video-camera calendar clock timer
code terminal-window git-branch git-pull-request bug wrench gear package cube stack database
tree-structure file-text files folder note-pencil list-checks kanban book-open graduation-cap
globe magnifying-glass link bookmark newspaper article rss
chart-line presentation-chart table receipt currency-dollar bank briefcase shopping-cart
palette pen-nib image film-slate music-note headphones microphone waveform game-controller
airplane map-pin house bed suitcase-rolling coffee fork-knife pizza heart star
users user-circle identification-card lock key shield-check
monitor devices hard-drives download upload cloud rocket-launch flask lightbulb sliders
sun moon leaf dog paw-print app-window"""

OUTPUT_SCHEMA = {
    "type": "object",
    "properties": {
        "workspaces": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {"type": "string"},
                    "name": {"type": "string"},
                    "icon": {"type": "string"},
                },
                "required": ["id", "name", "icon"],
            },
        }
    },
    "required": ["workspaces"],
}


LOG_PATH = STATE_DIR / "daemon.log"


def log(*a):
    line = " ".join([time.strftime("[%H:%M:%S]"), *map(str, a)])
    print(line, file=sys.stderr, flush=True)
    try:  # uwsm swallows stderr; keep a copy where `tail -f` can find it
        with LOG_PATH.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def load_json(path, fallback):
    try:
        return json.loads(Path(path).read_text())
    except Exception:
        return fallback


def write_atomic(path, payload):
    """FileView is watching this path; never let it see a half-written file."""
    tmp = Path(str(path) + ".tmp")
    tmp.write_text(json.dumps(payload, indent=2, sort_keys=True))
    tmp.replace(path)


def hyprctl(*args):
    # hyprctl can hang while the compositor is busy (a shell restart, say); a
    # bounded wait turns that into one skipped pass instead of a wedged daemon.
    out = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True, timeout=15)
    if out.returncode != 0:
        raise RuntimeError(f"hyprctl {args}: {out.stderr.strip()}")
    return json.loads(out.stdout)


def strip_status_glyphs(title):
    """Drop leading symbol characters: the spinners and status marks agent
    terminals put in front of their titles (Claude Code cycles through
    a whole set while it works) so the title, and with it a workspace's
    signature, stops changing every second."""
    i = 0
    while i < len(title) and (title[i].isspace() or unicodedata.category(title[i]) in ("So", "Sm", "Sk", "Cn")):
        i += 1
    return title[i:]


def clean_title(title):
    title = strip_status_glyphs(title)
    prev = None
    while title != prev:
        prev = title
        title = RE_APP_SUFFIX.sub("", title).strip()
    return title


# Small words stay lowercase in a workspace name unless they open or close it.
TITLE_CASE_SMALL_WORDS = {
    "a", "an", "and", "as", "at", "but", "by", "for", "from", "in", "nor",
    "of", "on", "or", "the", "to", "vs", "via", "with",
}


def _title_case_word(word, is_edge):
    """Capitalise one word of a workspace name, unless it's a token the model
    already gave us a reason not to touch: an all-caps acronym ("AI", "PR"),
    or something with internal capitals or a digit mixed with letters
    ("macOS", "iPhone", "k8s") that would be mangled by blind title-casing."""
    if not word:
        return word
    if len(word) >= 2 and word.isupper():
        return word
    if any(c.isupper() for c in word[1:]):
        return word
    if any(c.isdigit() for c in word) and any(c.isalpha() for c in word):
        return word
    lower = word.lower()
    if not is_edge and lower in TITLE_CASE_SMALL_WORDS:
        return lower
    return word[:1].upper() + word[1:].lower()


def title_case_name(name):
    """Title-case a workspace name: capitalise each word, except small words
    (a, the, of, ...) unless they're the first or last word. Preserves
    acronyms and tokens with internal caps or digits+letters as-is."""
    words = name.split(" ")
    last = len(words) - 1
    return " ".join(_title_case_word(w, i == 0 or i == last) for i, w in enumerate(words))


# ------------------------------------------------------------------ prompting

def system_prompt(max_name_chars):
    return f"""You label workspaces on a Linux tiling desktop. Each workspace is a list of its open windows, written as [window class] window title. Say what the person is doing on each workspace in a very short name, and pick one Phosphor icon for it.

The class tells you which tool is open. The title tells you what it is being used for. Always name the subject, never the tool: "email", not "browser"; "flight to lisbon", not "chrome"; "auth refactor", not "neovim".

Rules
- One window: name what that window is about. A workspace holding only Gmail is "email". Only Spotify is "music". Only a terminal at ~/src/foo is "foo".
- Several windows on one topic: name the topic.
- Several unrelated windows: name the one the person is most likely working in. Fall back to "browsing" only for a true grab-bag of unrelated pages.
- Terminal titles from AI coding tools (Claude Code and the like) describe the task in progress; name that task.
- If a workspace has a "previous" name and the windows still fit it, keep it. Do not rename a workspace just because someone opened a different email or switched tab within the same activity.
- Names: 1-3 words, at most {max_name_chars} characters, no trailing punctuation, no quotes. Every workspace gets a different name.
- Icon: the Phosphor icon name that best fits the subject, such as {" ".join(ICON_HINTS.split())}. Any Phosphor icon is allowed. Plain names only, no -fill or -bold variants.

Examples

Workspace 1:
  - [google-chrome] Inbox (1,432) - andy@gmail.com - Gmail
Workspace 2:
  - [google-chrome] Flights from LIS to LHR | Google Flights
  - [google-chrome] Lisbon hotels - Booking.com
Workspace 3:
  - [foot] nvim ~/src/billing/invoice.rb
  - [foot] andy@mac:~/src/billing
Workspace 4:
  - [Slack] #eng-platform - Acme
  - [google-chrome] RFC: auth token rotation - Google Docs
Workspace 5 (previous: "email"):
  - [google-chrome] Re: Q3 invoice - andy@gmail.com - Gmail

{{"workspaces": [
  {{"id": "1", "name": "email", "icon": "envelope"}},
  {{"id": "2", "name": "lisbon trip", "icon": "airplane"}},
  {{"id": "3", "name": "billing", "icon": "receipt"}},
  {{"id": "4", "name": "auth token rfc", "icon": "key"}},
  {{"id": "5", "name": "email", "icon": "envelope"}}
]}}"""


def user_prompt(pending, previous):
    lines = []
    for ws, windows in sorted(pending.items(), key=lambda kv: int(kv[0])):
        prev = previous.get(ws)
        head = f"Workspace {ws}" + (f' (previous: "{prev}")' if prev else "") + ":"
        lines.append(head)
        for cls, title in windows:
            lines.append(f"  - [{cls}] {title}" if title else f"  - [{cls}]")
    return "\n".join(lines) + "\n\nReply with the JSON object only."


def suggest_system_prompt(max_name_chars, ask_groups):
    """A different question than system_prompt(): that one names a batch of
    workspaces and remembers previous names; this one looks at ONE workspace
    right now and additionally asks whether some of its windows are a distinct
    enough sub-topic to split onto their own workspace."""
    if ask_groups:
        groups_rule = (
            '- Also look for a "spin out" grouping: a subset of the windows '
            "that share a sub-topic distinct enough to move to its own "
            "workspace. A group must leave at least one window behind -- "
            "proposing every window is not a split. Propose more than one "
            "group if there are several distinct sub-topics, or none if "
            "nothing stands out. Each group needs a short name in "
            "the same style as the workspace name, a Phosphor icon, and the "
            'list of window indices (from the ones you were given) it covers.'
        )
        groups_shape = ',\n  "groups": [{"name": "patio furniture", "icon": "armchair", "indices": [1, 3]}]'
    else:
        groups_rule = '- This workspace is too small to split; always return an empty "groups" list.'
        groups_shape = ',\n  "groups": []'
    return f"""You look at ONE Hyprland workspace and suggest a new name for it, plus whether any of its windows should split off onto their own workspace.

Each window is given as its index, its window class, and its title. Name the subject of the workspace, never the tool: "email", not "browser"; "auth refactor", not "neovim".

Rules
- Name: 1-3 words, at most {max_name_chars} characters, no trailing punctuation, no quotes.
- Icon: the Phosphor icon name that best fits the subject, such as {" ".join(ICON_HINTS.split())}. Any Phosphor icon is allowed. Plain names only, no -fill or -bold variants.
{groups_rule}

Reply with exactly one JSON object and nothing else, shaped like:

{{"name": "auth refactor", "icon": "code"{groups_shape}}}"""


def suggest_user_prompt(ws_arg, windows):
    lines = [f"  {i}: [{w['class']}] {w['title']}" if w["title"] else f"  {i}: [{w['class']}]"
             for i, w in enumerate(windows)]
    return f"Workspace {ws_arg}:\n" + "\n".join(lines) + "\n\nReply with the JSON object only."


def triage_system_prompt():
    """--triage: a different question again -- look at every window on every
    workspace at once and group them by what the person is DOING, not by
    which application happens to be open. Two terminals can be two different
    tasks; a mail client and a browser tab about the same thread are one."""
    return f"""You look at every window open across every workspace on a Linux desktop and sort them into a handful of groups by what the person is DOING right now -- never by which application is open.

Each window is given as its index, its workspace number, its window class, and its title.

Rules
- Group by activity or topic, not by app: a mail client and a browser tab about the same thread belong together; two terminal sessions on unrelated projects are two different groups even though both are class "foot".
- Every group needs a short name (1-3 words, same style as a workspace name) and one Phosphor icon, such as {" ".join(ICON_HINTS.split())}. Any Phosphor icon is allowed. Plain names only, no -fill or -bold variants.
- Put each window's index in exactly one group's "indices" list. If a window genuinely fits nowhere, leave its index out of every group entirely -- it will be shown on its own, you do not need an "other" catch-all.
- Prefer a handful of meaningful groups over one group per window or one per app.

Reply with exactly one JSON object and nothing else, shaped like:

{{"categories": [
  {{"name": "Email", "icon": "envelope", "indices": [0, 3]}},
  {{"name": "Lisbon Trip", "icon": "airplane", "indices": [1, 2]}}
]}}"""


def triage_user_prompt(windows):
    lines = [f"  {w['index']}: (workspace {w['workspace']}) [{w['class']}] {w['title']}" if w["title"]
             else f"  {w['index']}: (workspace {w['workspace']}) [{w['class']}]"
             for w in windows]
    return "Windows:\n" + "\n".join(lines) + "\n\nReply with the JSON object only."


# -------------------------------------------------------------- chrome tabs
#
# Hyprland's window title for a Chrome window is always the *active tab's*
# title -- Chrome never puts the URL in the OS window title -- so the daemon
# can't see URLs on its own. The literate-tabs extension (see
# ~/.config/omarchy/chrome-extensions/literate-tabs) pushes each window's
# tab list to a native-messaging host, which writes it here. This section
# reads that file and lines its windows up with Hyprland's, by title -- the
# only thing the two sides share -- so the model can be told more than the
# active tab's bare title.

def load_chrome_tabs(path=CHROME_TABS_PATH, max_age=CHROME_TABS_MAX_AGE, now=None):
    """The extension's last-reported list of Chrome windows, or None if the
    file is missing, unreadable, malformed, or older than max_age. Stale
    data is worse than none: a window that has since closed or navigated
    would otherwise go on "matching" forever."""
    data = load_json(path, None)
    if not isinstance(data, dict):
        return None
    updated = data.get("updatedAt")
    if not isinstance(updated, (int, float)):
        return None
    if (now if now is not None else time.time()) - updated > max_age:
        return None
    windows = data.get("windows")
    return windows if isinstance(windows, list) else None


def registrable_domain(url):
    """Host only -- no path, query, fragment, or credentials. This backs
    chrome_urls="domain", the default and the privacy-safe option."""
    try:
        from urllib.parse import urlsplit
        return urlsplit(url).hostname or ""
    except Exception:
        return ""


def match_chrome_windows(hypr_titles, chrome_windows):
    """hypr_titles: [(index, title), ...] for this pass's Chrome-class
    Hyprland windows. chrome_windows: the "windows" list from
    chrome-tabs.json. Returns {index: chrome_window_dict} for the pairs that
    match unambiguously.

    Title is the only thing a Hyprland window and an extension-reported
    window share -- there is no window-handle correlation available -- so a
    title that isn't unique on *either* side (two windows genuinely showing
    the same active tab title, e.g. two blank "New Tab" windows) can't be
    told apart and is left unmatched rather than guessed at.
    """
    hypr_counts = Counter(title for _, title in hypr_titles)
    chrome_counts = Counter()
    chrome_by_title = {}
    for w in chrome_windows:
        if not isinstance(w, dict):
            continue
        title = w.get("activeTitle")
        if not isinstance(title, str):
            continue
        chrome_counts[title] += 1
        chrome_by_title[title] = w
    matches = {}
    for index, title in hypr_titles:
        if hypr_counts[title] == 1 and chrome_counts.get(title) == 1:
            matches[index] = chrome_by_title[title]
    return matches


def chrome_url_suffix(title, window, mode, max_chars):
    """Text to append to a matched Chrome window's title before it reaches
    the prompt: the active tab's URL (per chrome_urls) plus, for a
    multi-tab window, the other tabs' titles. Folded into the title string
    itself so it flows through the existing prompt-building and
    signature/cache code unchanged -- a URL or tab-set change then changes
    the signature exactly like a title change always has."""
    if mode == "off":
        return ""
    tabs = window.get("tabs")
    tabs = [t for t in tabs if isinstance(t, dict)] if isinstance(tabs, list) else []
    parts = []
    active = next((t for t in tabs if t.get("title") == title), None)
    if active is not None:
        shown = registrable_domain(active.get("url") or "") if mode == "domain" else (active.get("url") or "")
        shown = shown[:max_chars]
        if shown:
            parts.append(f"[{shown}]")
    others = [t.get("title", "") for t in tabs if t.get("title") and t.get("title") != title]
    if others:
        parts.append("(other tabs: " + ", ".join(o[:max_chars] for o in others[:5]) + ")")
    return (" " + " ".join(parts)) if parts else ""


class Namer:
    def __init__(self):
        self.cfg = {**DEFAULTS, **load_json(CONFIG_PATH, {})}
        self.icons = load_json(PLUGIN_DIR / "phosphor-codepoints.json", {})
        if not self.icons:
            log("WARN: no phosphor-codepoints.json; icons will not be validated")
        self.cache = load_json(CACHE_PATH, {})
        self.state = load_json(STATE_PATH, {})
        self.pinned = load_json(PINNED_PATH, {})
        self.lock = threading.Lock()
        self.pass_lock = threading.Lock()
        # Triage precompute runs outside pass_lock (naming must never wait on
        # it), so it needs its own non-blocking guard against overlapping.
        self.triage_lock = threading.Lock()
        self.triage_sig = None
        self.triage_at = float("-inf")
        self.timer = None
        self.first_event = None
        self.last_sigs = {}
        # monotonic time of the last fast-clear per workspace, so a slow
        # in-flight pass that started before the clear can tell its answer
        # is stale and drop it instead of resurrecting the workspace.
        self.cleared_at = {}

    # ---------------------------------------------------------------- snapshot

    def _filtered_clients(self):
        """Yield (ws, class, title, address) for every window hyprctl reports,
        after the filtering every caller needs: special/scratchpad workspaces
        (negative ids) skipped, ignore_classes honoured, titles cleaned and
        clamped. snapshot() and --suggest both build on this so the rules
        can't drift apart between them.

        Chrome windows also get a URL suffix folded into their title here
        (see chrome_url_suffix()), so every caller and the cache signature
        see it identically -- there's nowhere else this can live without
        the two drifting apart."""
        ignore = {c.lower() for c in self.cfg["ignore_classes"]}
        raw = []
        for c in hyprctl("clients"):
            ws = (c.get("workspace") or {}).get("id")
            if not isinstance(ws, int) or ws < 1:
                continue  # special/scratchpad workspaces have negative ids
            cls = (c.get("initialClass") or c.get("class") or "").strip()
            if cls.lower() in ignore:
                continue
            title = clean_title((c.get("title") or "").strip())[: self.cfg["max_title_chars"]]
            raw.append([ws, cls, title, c.get("address", "")])

        self._enrich_chrome_titles(raw)

        for entry in raw:
            yield tuple(entry)

    def _enrich_chrome_titles(self, raw):
        """Mutate raw (list of [ws, cls, title, address]) in place, appending
        URL info to any Chrome window title that matches one reported by the
        literate-tabs extension. No-op if chrome_urls is "off" or no fresh
        report exists -- an unmatched or unreported window is left exactly
        as it was, today's behaviour."""
        mode = self.cfg.get("chrome_urls", "domain")
        if mode not in ("domain", "full"):
            return
        chrome_windows = load_chrome_tabs()
        if not chrome_windows:
            return
        hypr_titles = [(i, entry[2]) for i, entry in enumerate(raw)
                       if entry[1].lower() in CHROME_CLASSES]
        if not hypr_titles:
            return
        for i, window in match_chrome_windows(hypr_titles, chrome_windows).items():
            suffix = chrome_url_suffix(raw[i][2], window, mode, self.cfg["max_title_chars"])
            if suffix:
                raw[i][2] = raw[i][2] + suffix

    @staticmethod
    def group_by_workspace(clients):
        """workspace id -> list of (class, title), for real workspaces only."""
        by_ws = {}
        for ws, cls, title, _addr in clients:
            by_ws.setdefault(str(ws), []).append((cls, title))
        for wins in by_ws.values():
            wins.sort()
        return by_ws

    @staticmethod
    def triage_windows(clients):
        """The flat, indexed window list --triage groups and the triage cache
        stores. Split out from triage() so a pass can build it from the client
        list it already has, without a second hyprctl call."""
        return [{"index": i, "address": addr, "class": cls, "title": title, "workspace": str(ws)}
                for i, (ws, cls, title, addr) in enumerate(clients)]

    def snapshot(self):
        return self.group_by_workspace(self._filtered_clients())

    def workspace_windows(self, ws_id):
        """Every (filtered) window on one workspace, in hyprctl's own order,
        keeping the address -- snapshot() throws that away since naming only
        needs class+title, but --suggest hands addresses back to the caller."""
        return [{"address": addr, "class": cls, "title": title}
                for ws, cls, title, addr in self._filtered_clients() if ws == ws_id]

    @staticmethod
    def signature(windows):
        return json.dumps(windows, sort_keys=True)

    @staticmethod
    def triage_signature(windows):
        """A hash of the whole window set: every window's address, class,
        title and workspace. Sorted first, so merely reordering hyprctl's
        reply -- which happens on focus changes -- is not a change. This is
        the key the precomputed triage cache is stored and matched under."""
        key = sorted([w["address"], w["class"], w["title"], w["workspace"]] for w in windows)
        return hashlib.sha1(json.dumps(key).encode()).hexdigest()

    # ------------------------------------------------------------------- model

    def read_key_file(self):
        try:
            return Path(self.cfg["api_key_file"]).expanduser().read_text().strip()
        except OSError:
            return ""

    def api_available(self):
        try:
            import anthropic  # noqa: F401
        except ImportError:
            return False
        return bool(self.read_key_file()
                    or os.environ.get("ANTHROPIC_API_KEY")
                    or os.environ.get("ANTHROPIC_AUTH_TOKEN")
                    or (HOME / ".config/anthropic").exists())  # `ant auth login` profile

    def backend(self):
        chosen = self.cfg["backend"]
        if chosen == "auto":
            chosen = "api" if self.api_available() else "claude-cli"
        if chosen != getattr(self, "_announced_backend", None):
            self._announced_backend = chosen
            log(f"backend: {chosen} ({self.cfg['model'] if chosen != 'local' else self.cfg['local_model']})")
        return chosen

    def ask(self, system, user):
        backend = self.backend()
        if backend == "claude-cli":
            return self._ask_claude_cli(system, user)
        if backend == "api":
            return self._ask_api(system, user)
        if backend == "local":
            return self._ask_local(system, user)
        raise RuntimeError(f"unknown backend: {backend}")

    def _ask_claude_cli(self, system, user):
        # Strip the coding-agent harness: no tools, no MCP servers, and not
        # Claude Code's own system prompt (which pulls every answer towards
        # "coding"). Extended thinking is on by default in the CLI and turns a
        # 4-second answer into a 90-second one -- off. (--bare would be nice
        # too, but it skips the keychain read that holds the login.)
        r = subprocess.run(
            ["claude", "-p", user, "--model", self.cfg["model"],
             "--tools", "", "--no-session-persistence",
             "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
             "--system-prompt", system,
             "--output-format", "json"],
            env={**os.environ, "MAX_THINKING_TOKENS": "0"},
            capture_output=True, text=True, timeout=self.cfg["request_timeout"],
        )
        if r.returncode != 0:
            raise RuntimeError(f"claude cli: {r.stderr.strip()[:300]}")
        try:
            envelope = json.loads(r.stdout)
        except ValueError:
            return r.stdout
        if isinstance(envelope, dict):
            if envelope.get("is_error"):  # the CLI still exits 0 on these
                raise RuntimeError(f"claude cli: {envelope.get('result', '')!s:.300}")
            if isinstance(envelope.get("structured_output"), dict):
                return json.dumps(envelope["structured_output"])
            if "result" in envelope:
                return str(envelope["result"])
        return r.stdout

    def _ask_api(self, system, user):
        import anthropic
        if not hasattr(self, "_client"):
            key = self.read_key_file()
            # No key file: the SDK resolves ANTHROPIC_API_KEY / an `ant auth
            # login` profile on its own.
            self._client = anthropic.Anthropic(api_key=key) if key else anthropic.Anthropic()
        try:
            response = self._client.with_options(timeout=self.cfg["request_timeout"]).messages.create(
                model=self.cfg["model"],
                max_tokens=1024,
                system=system,
                messages=[{"role": "user", "content": user}],
            )
        except anthropic.AuthenticationError as e:
            raise RuntimeError(
                f"API auth failed ({e.message}); put a key in {self.cfg['api_key_file']} "
                f"or export ANTHROPIC_API_KEY") from e
        except anthropic.APIStatusError as e:
            raise RuntimeError(f"API error {e.status_code}: {e.message}") from e
        except anthropic.APIConnectionError as e:
            raise RuntimeError(f"API unreachable: {e}") from e
        if response.stop_reason == "max_tokens":
            log("WARN: reply hit max_tokens; names may be missing")
        return "".join(block.text for block in response.content if block.type == "text")

    def _ask_local(self, system, user):
        import urllib.request
        body = json.dumps({
            "model": self.cfg["local_model"],
            "max_tokens": 512,
            "temperature": 0.2,
            "messages": [{"role": "system", "content": system},
                         {"role": "user", "content": user}],
        }).encode()
        req = urllib.request.Request(
            self.cfg["local_url"], data=body,
            headers={"content-type": "application/json"})
        with urllib.request.urlopen(req, timeout=self.cfg["request_timeout"]) as f:
            return json.load(f)["choices"][0]["message"]["content"]

    def parse(self, raw):
        data = extract_json(raw)
        if isinstance(data.get("workspaces"), list):
            return {str(e.get("id")): e for e in data["workspaces"] if isinstance(e, dict)}
        return {str(k): v for k, v in data.items()}  # tolerate the keyed shape too

    def clean(self, entry):
        """Trust nothing the model said; clamp the name, validate the icon."""
        name = str(entry.get("name", "")).strip().strip(".\"'")
        name = re.sub(r"\s+", " ", name)[: self.cfg["max_name_chars"]].strip()
        name = title_case_name(name)
        icon = str(entry.get("icon", "")).strip().lower().replace("_", "-")
        icon = re.sub(r"^ph[-.]", "", icon)
        icon = re.sub(r"-(fill|bold|light|thin|duotone|regular)$", "", icon)
        if self.icons and icon not in self.icons:
            icon = "app-window" if "app-window" in self.icons else ""
        return {"name": name, "icon": icon} if name else None

    def name_workspaces(self, pending, previous):
        answer = self.parse(self.ask(system_prompt(self.cfg["max_name_chars"]),
                                     user_prompt(pending, previous)))
        return {ws: self.clean(answer.get(ws) or {}) for ws in pending}

    # -------------------------------------------------------------------- pass

    def run_pass(self, precompute=False):
        started = time.monotonic()  # see the cleared_at check in apply()
        with self.pass_lock:
            try:
                clients = list(self._filtered_clients())
            except Exception as e:
                log("snapshot failed:", e)
                return
            # Cheap, and lets `--pin`/`--unpin` from another process take
            # effect without restarting the daemon.
            self.pinned = load_json(PINNED_PATH, {})
            self.apply(self.group_by_workspace(clients), started)
        # Deliberately outside pass_lock: naming is the job, triage is
        # opportunistic, and a slow model call here must not hold up the next
        # naming pass. Only the daemon's own debounced fire() asks for it --
        # `--once` stays a single-call operation.
        if precompute:
            self.maybe_precompute_triage(self.triage_windows(clients))

    def apply(self, current, started):
        pending, resolved, sigs = {}, {}, {}
        for ws, windows in current.items():
            sig = self.signature(windows)
            sigs[ws] = sig
            if ws in self.pinned:
                resolved[ws] = self.pinned[ws]  # pinned: never asked, never cached
            elif sig in self.cache:
                resolved[ws] = self.cache[sig]
            elif self.last_sigs.get(ws) == sig and ws in self.state:
                resolved[ws] = self.state[ws]  # asked already and it failed; keep
            else:
                pending[ws] = windows

        if pending:
            previous = {ws: self.state[ws]["name"] for ws in pending if ws in self.state}
            log(f"asking {self.cfg['backend']} about workspace(s) {','.join(sorted(pending, key=int))}")
            try:
                for ws, entry in self.name_workspaces(pending, previous).items():
                    if entry:
                        resolved[ws] = entry
                        self.cache[sigs[ws]] = entry
                write_atomic(CACHE_PATH, self.cache)
            except Exception as e:
                log("naming failed:", e)
                for ws in pending:
                    if ws in self.state:
                        resolved[ws] = self.state[ws]

        # fast_clear_empty_workspaces() can land while name_workspaces() above
        # was waiting on the model. If a workspace this pass started with went
        # empty since, its answer here is stale -- drop it rather than
        # resurrecting a workspace that has already been correctly cleared.
        for ws in list(resolved):
            if self.cleared_at.get(ws, 0) > started:
                del resolved[ws]

        self.last_sigs = sigs
        if resolved != self.state:
            self.state = resolved
            write_atomic(STATE_PATH, resolved)
            log("wrote", ", ".join(f"{k}={v['name']}/{v['icon']}"
                                   for k, v in sorted(resolved.items(), key=lambda kv: int(kv[0])))
                or "(empty)")

    # ------------------------------------------------------------------- test

    def test(self, fixture_path):
        fixture = load_json(fixture_path, None)
        if not isinstance(fixture, dict):
            sys.exit(f"cannot read fixture {fixture_path}")
        pending = {}
        for ws, windows in fixture.items():
            if not ws.isdigit():
                continue
            pending[ws] = sorted((cls, clean_title(title)[: self.cfg["max_title_chars"]])
                                 for cls, title in windows)
        t0 = time.time()
        try:
            result = self.name_workspaces(pending, {})
        except RuntimeError as e:  # a config/auth problem, not a bug: no traceback
            sys.exit(f"naming failed: {e}")
        print(f"backend={self.backend()} model={self.cfg['model']} "
              f"{len(pending)} workspaces in {time.time() - t0:.1f}s\n")
        for ws in sorted(pending, key=int):
            entry = result.get(ws) or {"name": "??", "icon": "??"}
            print(f"{ws:>2}  {entry['name']:<18} {entry['icon']:<18}  "
                  + " | ".join(f"[{c}] {t}" for c, t in pending[ws]))

    # ---------------------------------------------------------------- suggest

    def suggest(self, ws_arg):
        """One workspace, one model call: a fresh name plus any "spin out"
        groupings worth splitting onto their own workspace. Pure read path --
        no cache, no state file, no daemon loop. Returns (payload, exit_code)
        rather than printing/exiting itself, so tests can call it directly."""
        try:
            ws_id = int(ws_arg)
        except ValueError:
            return {"workspace": ws_arg, "error": "workspace id must be an integer"}, 1
        try:
            windows = self.workspace_windows(ws_id)
        except Exception as e:
            return {"workspace": ws_arg, "error": f"hyprctl failed: {e}"[:200]}, 1
        if not windows:
            return {"workspace": ws_arg, "error": "workspace has no windows"}, 1

        # Groups only make sense once there's something left to leave behind
        # after spinning windows out; below that, skip asking for them at all.
        want_groups = len(windows) > 2
        try:
            raw = self.ask(suggest_system_prompt(self.cfg["max_name_chars"], want_groups),
                            suggest_user_prompt(ws_arg, windows))
            data = extract_json(raw)
            if not isinstance(data, dict):
                raise ValueError("model reply was not a JSON object")
        except Exception as e:
            return {"workspace": ws_arg, "error": str(e)[:200]}, 1

        cleaned = self.clean(data)
        if not cleaned:
            return {"workspace": ws_arg, "error": "model did not return a usable name"}, 1

        groups = []
        if want_groups:
            for g in data.get("groups") or []:
                if not isinstance(g, dict):
                    continue
                try:
                    indices = sorted({int(i) for i in g.get("indices") or []})
                except (TypeError, ValueError):
                    continue  # trust nothing the model said
                if not indices or any(i < 0 or i >= len(windows) for i in indices):
                    continue  # references a window that doesn't exist
                if len(indices) >= len(windows):
                    continue  # not a strict subset -- must leave something behind
                cg = self.clean(g)
                if cg:
                    groups.append({"name": cg["name"], "icon": cg["icon"], "indices": indices})

        return {
            "workspace": ws_arg,
            "name": cleaned["name"],
            "icon": cleaned["icon"],
            "windows": [{"index": i, **w} for i, w in enumerate(windows)],
            "groups": groups,
        }, 0

    # ---------------------------------------------------------------- triage

    def triage(self, use_cache=True):
        """Every window on every real workspace, grouped by what the person is
        doing rather than which app is open. Returns (payload, exit_code).

        The daemon precomputes this after every settled naming pass, so the
        common case is a file read and no model call at all. A miss -- no
        cache, a window set that has moved on, or precompute switched off --
        falls back to asking the model live, exactly as this always did.
        `cached` in the payload says which happened."""
        try:
            windows = self.triage_windows(list(self._filtered_clients()))
        except Exception as e:
            return {"error": f"hyprctl failed: {e}"[:200]}, 1
        if not windows:
            return {"categories": [], "windows": [], "cached": False}, 0

        signature = self.triage_signature(windows)
        if use_cache:
            hit = self.read_triage_cache(signature)
            if hit is not None:
                return {**hit, "cached": True}, 0

        payload, code = self.compute_triage(windows)
        if code == 0 and use_cache:
            # A live miss still warms the cache: the next press is instant
            # even if the daemon is not running at all.
            self.write_triage_cache(signature, payload)
        payload["cached"] = False
        return payload, code

    def compute_triage(self, windows):
        """The model call and all the validation behind it. Shared verbatim by
        --triage's live path and the daemon's precompute, so the two can't
        drift into disagreeing about the shape of the answer."""
        try:
            raw = self.ask(triage_system_prompt(), triage_user_prompt(windows))
            data = extract_json(raw)
            if not isinstance(data, dict):
                raise ValueError("model reply was not a JSON object")
        except Exception as e:
            return {"error": str(e)[:200]}, 1

        # Trust nothing the model said: every index must name a real window,
        # and once an index has landed in one category it cannot land in
        # another -- a window must never appear twice.
        valid_indices = set(range(len(windows)))
        seen = set()
        categories = []
        for cat in data.get("categories") or []:
            if not isinstance(cat, dict):
                continue
            cleaned = self.clean(cat)
            if not cleaned:
                continue
            try:
                indices = sorted({int(i) for i in cat.get("indices") or []})
            except (TypeError, ValueError):
                continue
            indices = [i for i in indices if i in valid_indices and i not in seen]
            if not indices:
                continue
            seen.update(indices)
            categories.append({"name": cleaned["name"], "icon": cleaned["icon"], "indices": indices})

        # Anything the model missed, mis-indexed, or that came back malformed
        # must still show up somewhere rather than silently vanish.
        leftover = sorted(valid_indices - seen)
        if leftover:
            categories.append({
                "name": "Uncategorised",
                "icon": "app-window" if (not self.icons or "app-window" in self.icons) else "",
                "indices": leftover,
            })

        return {"categories": categories, "windows": windows}, 0

    # -------------------------------------------------------- triage cache

    @staticmethod
    def read_triage_cache(signature):
        """The cached grouping if it was computed for exactly this window set,
        else None. A missing, truncated or hand-mangled file is a miss, never
        an error -- the caller just asks the model instead."""
        data = load_json(TRIAGE_PATH, None)
        if not isinstance(data, dict) or data.get("signature") != signature:
            return None
        categories, windows = data.get("categories"), data.get("windows")
        if not isinstance(categories, list) or not isinstance(windows, list):
            return None
        return {"categories": categories, "windows": windows,
                "updatedAt": data.get("updatedAt")}

    @staticmethod
    def write_triage_cache(signature, payload):
        write_atomic(TRIAGE_PATH, {
            "signature": signature,
            "categories": payload.get("categories") or [],
            "windows": payload.get("windows") or [],
            "updatedAt": int(time.time()),
        })

    def maybe_precompute_triage(self, windows):
        """Work out the triage grouping for the window set a settled pass just
        saw, so the triage key is a file read rather than a model call.

        Everything here is a reason not to ask:
          - switched off, or nothing is open;
          - this exact window set is already grouped (in memory, or on disk
            from another process's live --triage), so never twice for one
            signature;
          - the last precompute was too recent -- the naming cache is per
            workspace, but this signature is global, so one chatty title would
            otherwise re-ask about the whole desktop every debounce window;
          - one is already in flight.
        A failure is logged and dropped: the signature is not recorded, so the
        next settled pass retries, and --triage meanwhile just asks live."""
        if not self.cfg.get("triage_precompute", True) or not windows:
            return
        signature = self.triage_signature(windows)
        if signature == self.triage_sig:
            return
        if self.read_triage_cache(signature) is not None:
            self.triage_sig = signature
            return
        now = time.monotonic()
        wait = self.cfg["triage_min_interval"] - (now - self.triage_at)
        if wait > 0:
            log(f"triage precompute skipped ({wait:.0f}s under the {self.cfg['triage_min_interval']:.0f}s floor)")
            return
        if not self.triage_lock.acquire(blocking=False):
            return
        try:
            self.triage_at = now
            t0 = time.time()
            payload, code = self.compute_triage(windows)
            if code != 0:
                log("triage precompute failed:", payload.get("error"))
                return
            self.write_triage_cache(signature, payload)
            self.triage_sig = signature
            log(f"triage precomputed: {len(windows)} windows -> "
                f"{len(payload['categories'])} categories in {time.time() - t0:.1f}s")
        except Exception as e:  # opportunistic: never let this wedge the daemon
            log("triage precompute failed:", e)
        finally:
            self.triage_lock.release()

    # --------------------------------------------------------------------- pin

    def pin(self, ws_arg, name, icon=None):
        """One-shot, no daemon loop: fix a workspace's name/icon so apply()
        skips the model for it. Not tied to hyprctl at all -- a pin can be
        set for a workspace that has no windows (or doesn't exist) yet, so
        the menu can pin a spot ahead of opening anything in it."""
        ws = str(ws_arg)
        if icon is None:
            # No icon given: keep the one the workspace (or an existing pin
            # on it) already has, same as clean() falling back on its own.
            icon = (self.state.get(ws) or self.pinned.get(ws) or {}).get("icon", "")
        cleaned = self.clean({"name": name, "icon": icon})
        if not cleaned:
            return {"error": "name is empty after cleaning"}, 1
        self.pinned[ws] = cleaned
        write_atomic(PINNED_PATH, self.pinned)
        self.show_pin_now(ws, cleaned)
        return cleaned, 0

    def unpin(self, ws_arg):
        ws = str(ws_arg)
        if ws not in self.pinned:
            return {"error": f"workspace {ws} is not pinned"}, 1
        del self.pinned[ws]
        write_atomic(PINNED_PATH, self.pinned)
        self.show_pin_now(ws, None)
        return {}, 0

    @staticmethod
    def show_pin_now(ws, entry):
        """Push a pin straight onto the bar instead of waiting for a pass.

        pinned.json is what apply() consults, but workspaces.json is what the
        widget renders, and a pass only runs on a Hyprland event plus the
        debounce. Writing only the pin means a rename from the menu appears to
        do nothing on a quiet desktop -- the name is correct on disk and
        invisible for minutes. Write both.

        This races the daemon, which owns workspaces.json, but only benignly:
        a pass already in flight re-reads pinned.json before it decides, so
        the worst case is one stale render that the next pass corrects.
        """
        state = load_json(STATE_PATH, {})
        if entry is None:
            # Drop the old pinned label rather than leave it showing; the next
            # pass names the workspace again if it still has windows.
            if state.pop(ws, None) is None:
                return
        else:
            if state.get(ws) == entry:
                return
            state[ws] = entry
        write_atomic(STATE_PATH, state)

    # ------------------------------------------------------------------ events

    def fast_clear_empty_workspaces(self):
        """closewindow carries only the window's address, not its workspace,
        so there is no way to know which workspace to check without asking
        Hyprland -- but that ask needs no model call, just a diff against
        what we last knew had windows, so there is nothing to gain from
        waiting on the debounce for it. Wiping a workspace's entry the
        instant it goes to zero windows is what makes the bar clear
        immediately instead of lagging by a whole debounce window."""
        try:
            current = self.snapshot()
        except Exception as e:
            log("fast-clear snapshot failed:", e)
            return
        emptied = [ws for ws in self.state if ws not in current]
        if not emptied:
            return
        now = time.monotonic()
        for ws in emptied:
            self.cleared_at[ws] = now  # lets apply() reject a late, stale answer
        self.state = {ws: v for ws, v in self.state.items() if ws not in emptied}
        self.last_sigs = {ws: v for ws, v in self.last_sigs.items() if ws not in emptied}
        write_atomic(STATE_PATH, self.state)
        log("cleared", ",".join(sorted(emptied, key=int)), "(emptied)")

    def schedule(self):
        """Debounce, with a ceiling: a stream of events still yields a pass
        within max_wait of the first one."""
        now = time.monotonic()
        with self.lock:
            if self.timer:
                self.timer.cancel()
            if self.first_event is None:
                self.first_event = now
            delay = min(self.cfg["debounce"], max(0.0, self.first_event + self.cfg["max_wait"] - now))
            self.timer = threading.Timer(delay, self.fire)
            self.timer.daemon = True
            self.timer.start()

    def fire(self):
        with self.lock:
            self.first_event = None
        self.run_pass(precompute=True)

    def listen_forever(self):
        """Reconnect rather than die: the socket goes away on Hyprland reload."""
        while True:
            try:
                self.listen()
            except Exception as e:
                log("listener stopped:", e)
            time.sleep(2)

    def listen(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        if not sig:
            raise RuntimeError("HYPRLAND_INSTANCE_SIGNATURE unset -- is Hyprland running?")
        path = f"{runtime}/hypr/{sig}/.socket2.sock"

        watched = ("openwindow", "closewindow", "movewindowv2",
                   "windowtitlev2", "workspacev2", "createworkspacev2",
                   "destroyworkspacev2")
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(path)
        log("listening on", path)
        self.schedule()  # name what's already open

        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                raise RuntimeError("hyprland socket closed")
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                event = line.decode("utf-8", "replace").split(">>", 1)[0]
                if event == "closewindow":
                    self.fast_clear_empty_workspaces()
                if event in watched:
                    self.schedule()


if __name__ == "__main__":
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    namer = Namer()
    if "--test" in sys.argv:
        namer.test(sys.argv[sys.argv.index("--test") + 1])
    elif "--once" in sys.argv:
        namer.run_pass()
    elif "--suggest" in sys.argv:
        i = sys.argv.index("--suggest")
        if i + 1 >= len(sys.argv):
            sys.exit("--suggest requires a workspace id")
        try:
            payload, code = namer.suggest(sys.argv[i + 1])
        except Exception as e:  # a bug here must still exit clean, never a traceback
            payload, code = {"workspace": sys.argv[i + 1], "error": str(e)[:200]}, 1
        print(json.dumps(payload, separators=(",", ":")))
        sys.exit(code)
    elif "--triage" in sys.argv:
        try:
            payload, code = namer.triage(use_cache="--no-cache" not in sys.argv)
        except Exception as e:  # a bug here must still exit clean, never a traceback
            payload, code = {"error": str(e)[:200]}, 1
        print(json.dumps(payload, separators=(",", ":")))
        sys.exit(code)
    elif "--pin" in sys.argv:
        i = sys.argv.index("--pin")
        rest = sys.argv[i + 1:]
        if len(rest) < 2:
            print(json.dumps({"error": "--pin requires a workspace id and a name"}))
            sys.exit(1)
        ws_arg, name = rest[0], rest[1]
        icon = rest[2] if len(rest) > 2 else None
        result, code = namer.pin(ws_arg, name, icon)
        if code == 0:
            print(f'pinned workspace {ws_arg} as "{result["name"]}" ({result["icon"]})')
        else:
            print(json.dumps(result))
        sys.exit(code)
    elif "--unpin" in sys.argv:
        i = sys.argv.index("--unpin")
        if i + 1 >= len(sys.argv):
            print(json.dumps({"error": "--unpin requires a workspace id"}))
            sys.exit(1)
        ws_arg = sys.argv[i + 1]
        result, code = namer.unpin(ws_arg)
        if code == 0:
            print(f"unpinned workspace {ws_arg}")
        else:
            print(json.dumps(result))
        sys.exit(code)
    else:
        namer.listen_forever()
